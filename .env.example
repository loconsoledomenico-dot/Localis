# Site
PUBLIC_SITE_URL=https://localis.guide

# Stripe (test mode for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (one per product). Required in prod, else
# src/data/stripe-prices.json placeholders are used (checkout will throw).
Stripe_id_singola=price_...     # Single guide · €4.99
Stripe_id_essenziale=price_...  # Bari Essenziale (3 guides) · €9.99
Stripe_id_bundle=price_...      # Bari Completa (6 guides) · €14.99
Stripe_id_crociera=price_...    # Cruise package - EUR 7.99

# JWT (generate: openssl rand -hex 32)
JWT_SECRET=change-me-32-random-chars-minimum
# Optional comma-separated revocation lists.
# Hash a token with SHA-256 for JWT_REVOKED_TOKEN_HASHES, or list Stripe checkout session IDs.
JWT_REVOKED_TOKEN_HASHES=
JWT_REVOKED_SESSION_IDS=

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Localis <noreply@localis.guide>

# Plausible (Milestone F)
PUBLIC_PLAUSIBLE_DOMAIN=localis.guide

# Google Analytics 4 — referral tracking via ?p=<slug> in QR codes
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Search Console tooling (local scripts)
GSC_SITE_URL=sc-domain:localis.guide
GSC_SITEMAP_URL=https://localis.guide/sitemap-index.xml

# PostHog product analytics (EU Cloud recommended for Localis)
PUBLIC_POSTHOG_KEY=phc_...
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional server-side purchase tracking. Defaults to PUBLIC_POSTHOG_* when omitted.
POSTHOG_PROJECT_API_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (Milestone F)
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# Cloudflare R2 (Milestone D)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=localis-audio
R2_PUBLIC_URL=

# Stripe Connect (Milestone E)
STRIPE_CONNECT_CLIENT_ID=ca_...

# ElevenLabs (Milestone D content production)
ELEVENLABS_API_KEY=
DOMENICO_VOICE_ID=
