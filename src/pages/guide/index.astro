---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import GuideBuilder from '../../components/GuideBuilder.astro';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  duration: string;
  area: string;
  cover: string;
  alt: string;
  price?: string;
  soon?: boolean;
}

const bariGuides: GuideEntry[] = [
  {
    slug: 'bari-vecchia',
    title: 'Bari Vecchia — Dentro la Città',
    subtitle: 'Il borgo antico, quattromila anni di storia.',
    duration: '21 min',
    area: 'Borgo Antico',
    cover: '/images/covers/bari-vecchia.jpg',
    alt: 'Vicolo del Borgo Antico di Bari con colonne romane e palazzi storici',
    price: '€4,99',
  },
  {
    slug: 'san-nicola',
    title: 'San Nicola — Il Santo Rubato',
    subtitle: 'Come le ossa di un santo divennero una città.',
    duration: '30 min',
    area: 'Borgo Antico',
    cover: '/images/covers/san-nicola.jpg',
    alt: 'Processione di San Nicola al tramonto davanti alla Basilica',
    price: '€4,99',
  },
  {
    slug: 'il-meglio-di-bari',
    title: 'Il Meglio di Bari — Mangia Prima di Capire',
    subtitle: 'Orecchiette, sgagliozze e focaccia barese.',
    duration: '29 min',
    area: 'Borgo Antico',
    cover: '/images/covers/il-meglio-di-bari.jpg',
    alt: 'Strada delle Orecchiette a Bari Vecchia, donne che lavorano la pasta',
    price: '€4,99',
  },
  {
    slug: 'porto-bari',
    title: 'Porto di Bari — Dove è Successo Tutto',
    subtitle: 'Crociati, commercianti, migranti.',
    duration: '33 min',
    area: 'Lungomare',
    cover: '/images/covers/porto-bari.jpg',
    alt: 'Bari dal alto al tramonto, lungomare e porto turistico',
    price: '€4,99',
  },
  {
    slug: 'tre-teatri',
    title: 'I Tre Teatri — Fuoco, Musica e Borghesia',
    subtitle: 'La Bari che volle diventare città europea.',
    duration: '28 min',
    area: 'Murat',
    cover: '/images/covers/tre-teatri.jpg',
    alt: 'Teatro Margherita di Bari, edificio liberty sul mare',
    price: '€4,99',
  },
  {
    slug: 'bari-sotterranea',
    title: 'Bari Sotterranea — Quello che sta sotto',
    subtitle: 'Cisterne, catacombe e città sepolta.',
    duration: '25 min',
    area: 'Borgo Antico',
    cover: '/images/covers/bari-sotterranea-v2.jpg',
    alt: 'Cripta della Basilica di San Nicola, colonne romane e mosaici',
    price: '€4,99',
  },
];

const valleItria: GuideEntry[] = [
  {
    slug: 'alberobello',
    title: 'Alberobello — Dentro i Trulli',
    subtitle: 'La storia fiscale che nessuno ti ha mai raccontato.',
    duration: '35 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/alberobello.jpg',
    alt: 'Trulli di Alberobello, Rione Monti',
    price: '€4,99',
  },
  {
    slug: 'locorotondo',
    title: 'Locorotondo — Il Borgo Rotondo',
    subtitle: 'Un vino DOC, le cummerse e l\'olio essenziale di lavanda.',
    duration: '31 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/locorotondo.jpg',
    alt: 'Locorotondo, case bianche con tetti a doppio spiovente',
    price: '€4,99',
  },
  {
    slug: 'martina-franca',
    title: 'Martina Franca — La Città Franca',
    subtitle: 'Trecento anni di ducato attraverso la memoria storica della città.',
    duration: '30 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/martina-franca.jpg',
    alt: 'Palazzo Ducale di Martina Franca, cortile barocco',
    price: '€4,99',
  },
  {
    slug: 'cisternino',
    title: 'Cisternino — Il Paese del Fornello',
    subtitle: 'Il fornello pronto, la bombetta e il rito della brace nel centro storico.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/cisternino.jpg',
    alt: 'Cisternino, centro storico bianco con fornello pronto',
    price: '€4,99',
  },
  {
    slug: 'ostuni',
    title: 'Ostuni — La Città Bianca',
    subtitle: 'Vicoli bianchi, estati affollate e inverni silenziosi.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/ostuni.jpg',
    alt: 'Ostuni, la città bianca vista dal basso',
    price: '€4,99',
  },
  {
    slug: 'fasano',
    title: 'Fasano / Selva di Fasano — La Valle Vista dall\'Alto',
    subtitle: 'La Valle d\'Itria vista dall\'alto, tra trulli, masserie e colline.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/fasano.jpg',
    alt: 'Selva di Fasano, bosco e trulli visti dall\'alto',
    price: '€4,99',
  },
];
---

<Layout
  title="Guide — Audioguide narrative di Bari, Valle d'Itria e Gargano · Localis"
  description="Tutte le audioguide Localis: 18 racconti audio tra Bari, Valle d'Itria e Gargano, scritti da chi quei luoghi li vive. Da €4,99."
  lang="it"
>
  <div class="max-w-wrap mx-auto px-md py-2xl lg:py-3xl">

    {/* PAGE HEADER */}
    <header class="mb-3xl max-w-[52ch]">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Tutte le guide
        </span>
      </div>
      <h1 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(2rem,5vw,3.2rem)]">
        <span class="font-light">La Puglia, raccontata luogo per luogo.</span>
        <span class="block font-body font-normal text-ink mt-sm text-[clamp(1.1rem,2.2vw,1.45rem)] leading-relaxed tracking-normal">
          Racconti audio documentati per capire Bari, la Valle d'Itria e il Gargano.
        </span>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
        Qui trovi racconti audio documentati, scritti in Puglia, per capire i luoghi mentre li visiti o prima di partire. Ogni guida nasce da ricerca, fonti consultabili e scrittura pensata per farti entrare nel significato dei luoghi.
      </p>
      <p class="font-body text-sm leading-relaxed text-ink-muted mt-sm">
        Puoi acquistare una guida singola, oppure creare un pack da 3 o 6 guide.
      </p>
    </header>

    {/* ——— BARI ——— */}
    <section class="mb-3xl lg:mb-4xl" aria-labelledby="area-bari">
      <div class="flex items-baseline gap-md mb-2xl border-b border-border pb-md">
        <h2 id="area-bari" class="font-display font-light text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink tracking-tight">
          Bari
        </h2>
        <span class="font-body text-sm text-ink-muted">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {bariGuides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>

    </section>

    {/* ——— VALLE D'ITRIA ——— */}
    <section aria-labelledby="area-valle">
      <div class="flex items-baseline gap-md mb-2xl border-b border-border pb-md">
        <h2 id="area-valle" class="font-display font-light text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink tracking-tight">
          Valle d'Itria
        </h2>
        <span class="font-body text-sm text-ink-muted">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {valleItria.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {/* ——— GARGANO ——— */}
    <section class="mt-3xl lg:mt-4xl" aria-labelledby="area-gargano">
      <div class="flex items-baseline gap-md mb-2xl border-b border-border pb-md">
        <h2 id="area-gargano" class="font-display font-light text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink tracking-tight">
          Gargano
        </h2>
        <span class="font-body text-sm text-ink-muted">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {[
          { slug: 'gargano-vieste', title: 'Vieste — La Città sul Promontorio', subtitle: 'Pizzomunno, le falesie bianche, Pugnochiuso.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-vieste.jpg', alt: 'Vieste, promontorio di roccia bianca sul mare del Gargano', price: '€4,99' },
          { slug: 'gargano-nord', title: 'Il Gargano del Silenzio — Borghi, Trabucchi e Costa', subtitle: 'Trabucchi, costa e borghi del Gargano settentrionale.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-nord.jpg', alt: 'Trabucco sul mare del Gargano settentrionale', price: '€4,99' },
          { slug: 'gargano-sacro', title: 'Il Sacro Monte — Foresta, Fede e Pellegrini', subtitle: 'Foresta Umbra, Monte Sant\'Angelo, San Giovanni Rotondo.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-sacro.jpg', alt: 'Monte Sant\'Angelo, santuario di San Michele Arcangelo', price: '€4,99' },
          { slug: 'gargano-tremiti', title: 'Le Tremiti — L\'Arcipelago Dimenticato', subtitle: 'San Domino, San Nicola, le grotte marine.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-tremiti.jpg', alt: 'Isole Tremiti, acque cristalline e scogliere', price: '€4,99' },
          { slug: 'gargano-paesi', title: 'I Paesi del Gargano — Pietra Bianca e Vicoli', subtitle: 'Il Gargano che non si raggiunge col navigatore sul mare.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-paesi.jpg', alt: 'Vico del Gargano, vicoli del centro storico', price: '€4,99' },
          { slug: 'gargano-saline', title: 'Le Saline di Margherita — Sale e Fenicotteri', subtitle: 'Il sale più grande d\'Italia e la città abbandonata.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-saline.jpg', alt: 'Saline di Margherita di Savoia, fenicotteri rosa', price: '€4,99' },
        ].map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

  </div>

  <GuideBuilder lang="it" />

</Layout>

<style>
.guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--color-ink);
    padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover { transform: translateY(-2px); }
  .guide-card.is-soon {
    border-top-style: dashed;
    border-top-color: var(--color-border);
    cursor: default;
  }

  .guide-photo {
    display: block;
    position: relative;
    width: 100%;
    height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide-img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(0.94) contrast(1.04);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover .guide-img { transform: scale(1.03); }

  .guide-soon-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-sm);
    background: radial-gradient(ellipse at 50% 40%, oklch(78% 0.012 75) 0%, oklch(78% 0.012 75) 28%, transparent 48%), var(--color-surface-elev);
  }
  .guide-soon-num {
    font-family: var(--font-display); font-style: italic; font-weight: 300;
    font-size: clamp(4rem, 9vw, 6rem); line-height: 1; color: var(--color-accent);
    letter-spacing: -0.04em; user-select: none; opacity: 0.55;
  }
  .guide-soon-label {
    font-family: var(--font-body); font-size: 10px; font-weight: 700;
    letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-ink-subtle);
  }

  .guide-num {
    position: absolute; top: var(--spacing-sm); left: var(--spacing-sm);
    font-family: var(--font-display); font-style: italic; font-weight: 300;
    font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85;
    color: var(--color-surface); letter-spacing: -0.04em;
    text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55);
    pointer-events: none; user-select: none;
  }
  .guide-price {
    position: absolute; top: var(--spacing-sm); right: var(--spacing-sm);
    font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700;
    color: var(--color-ink); background: var(--color-surface);
    border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2;
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18);
    pointer-events: none; user-select: none; z-index: 1;
  }
  .guide-scrim {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--spacing-sm) var(--spacing-md);
    background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%);
    color: var(--color-surface); font-family: var(--font-body);
    font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    pointer-events: none;
  }
  .guide-area { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-dur { flex-shrink: 0; color: var(--color-accent-soft); }

  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); margin-top: var(--spacing-md); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-sub { line-height: 1.5; }

  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; }
  }
</style>
