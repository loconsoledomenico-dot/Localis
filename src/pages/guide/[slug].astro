---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PriceCard from '../../components/PriceCard.astro';
import ChapterList from '../../components/ChapterList.astro';
import StartMap from '../../components/StartMap.astro';
import NarratorCard from '../../components/NarratorCard.astro';
import StructuredData from '../../components/StructuredData.astro';
import GuideUseCase from '../../components/GuideUseCase.astro';
import GuideFactsCard from '../../components/GuideFactsCard.astro';
import GuideSeoEditorial from '../../components/GuideSeoEditorial.astro';
import { getCollection } from 'astro:content';
import { formatDuration } from '../../lib/format';
import { guideAccessibility, guideNeeds, guideRouteMode, guideStopsCount } from '../../lib/guide-localization';
import { audioObjectLD, breadcrumbListLD, touristAttractionLD, productLD } from '../../lib/seo';
import Breadcrumb from '../../components/Breadcrumb.astro';

const CITY_DEST: Record<string, { href: string; label: string }> = {
  bari: { href: '/bari', label: 'Bari' },
  polignano: { href: '/bari', label: 'Bari' },
  alberobello: { href: '/valle-d-itria', label: "Valle d'Itria" },
  locorotondo: { href: '/valle-d-itria', label: "Valle d'Itria" },
  'martina-franca': { href: '/valle-d-itria', label: "Valle d'Itria" },
  cisternino: { href: '/valle-d-itria', label: "Valle d'Itria" },
  ostuni: { href: '/valle-d-itria', label: "Valle d'Itria" },
  fasano: { href: '/valle-d-itria', label: "Valle d'Itria" },
  vieste: { href: '/gargano', label: 'Gargano' },
  gargano: { href: '/gargano', label: 'Gargano' },
  matera: { href: '/matera', label: 'Matera' },
};

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.status === 'live')
    .map((guide) => ({
      params: { slug: guide.data.slug },
      props: { guide },
    }));
}

const { guide } = Astro.props;
const data = guide.data;
const destinationLabel = CITY_DEST[data.city]?.label ?? data.city;
const destination = CITY_DEST[data.city];

const durationLabel = formatDuration(data.duration_seconds);
const stopsCount = guideStopsCount(data);
const routeMode = guideRouteMode(data, 'it') ?? 'Passeggiata urbana libera';
const accessibility = guideAccessibility(data, 'it') ?? 'Centro storico su pavimentazione mista, adatto alla maggior parte dei visitatori.';
const needs = guideNeeds(data, 'it') ?? 'Un paio di cuffie e smartphone carico.';
const zoneBundle: 'bari-completa' | 'valle-completa' | 'gargano-completa' | null =
  data.city === 'bari' || data.city === 'polignano'
    ? 'bari-completa'
    : data.city === 'vieste' || data.city === 'gargano'
      ? 'gargano-completa'
      : data.city === 'matera'
        ? null
        : 'valle-completa';

const ld: object[] = [
  audioObjectLD({
    slug: data.slug,
    title: data.title_it,
    description: data.seo.description_it,
    durationSeconds: data.duration_seconds,
    language: 'it',
    priceCents: data.price_cents,
    coords: data.coords_start,
    cityName: data.city,
  }),
];

if (data.coords_start) {
  ld.push(
    touristAttractionLD(
      data.title_it,
      data.coords_start,
      data.city.charAt(0).toUpperCase() + data.city.slice(1),
    ),
  );
}

ld.push(productLD({
  slug: data.slug,
  title: data.title_it,
  description: data.seo.description_it,
  cover: data.cover,
  priceCents: data.price_cents,
  language: 'it',
}));

ld.push(breadcrumbListLD([
  { name: 'Home', url: 'https://localis.guide/' },
  ...(destination ? [{ name: destination.label, url: `https://localis.guide${destination.href}` }] : []),
  { name: data.title_it, url: `https://localis.guide/guide/${data.slug}/` },
]));
---
<Layout title={`Audioguida ${data.title_it} | Localis`} description={data.seo.description_it} lang="it" ogImage={`/og/og-${data.slug}.jpg`}>
  <StructuredData data={ld} />
  {destination ? <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: destination.label, href: destination.href }, { label: data.title_it }]} /> : <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: data.title_it }]} />}
  <article class="max-w-wrap mx-auto px-md py-2xl grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-2xl items-start">
    <header class="lg:col-span-2 mb-2xl">
      <Eyebrow class="mb-md">{`${destinationLabel} · ${durationLabel} · IT/EN/DE`}</Eyebrow>
      <h1 class="font-display text-4xl text-ink leading-tight mb-sm">{data.title_it}</h1>
      <p class="font-display italic text-2xl text-ink-muted">{data.subtitle_it}</p>
    </header>

    <div class="flex flex-col gap-lg">
      <img
        src={data.cover}
        alt={`Copertina della guida ${data.title_it}`}
        class="w-full aspect-[4/3] object-cover rounded-lg"
        loading="eager"
      />

      <GuideUseCase guide={data} lang="it" />
      <GuideFactsCard
        lang="it"
        distanceKm={data.distance_km}
        stopsCount={stopsCount}
        routeMode={routeMode}
        accessibility={accessibility}
        needs={needs}
      />

      {data.narrator && (
        <NarratorCard
          name={data.narrator.name}
          photo={data.narrator.photo}
          bio={data.narrator.bio_it}
          lang="it"
        />
      )}

      <section>
        <h2 class="font-display text-3xl text-ink mb-md">Capitoli</h2>
        <ChapterList chapters={data.chapters} lang="it" />
      </section>

      <GuideSeoEditorial slug={data.slug} lang="it" />

      {data.coords_start && (
        <StartMap lat={data.coords_start.lat} lng={data.coords_start.lng} lang="it" />
      )}
    </div>

    <aside class="lg:sticky lg:top-24 flex flex-col gap-md">
      <PriceCard
        product="single"
        guideSlug={data.slug}
        lang="it"
        features={[
          `${data.chapters.length} capitoli`,
          `${durationLabel} di ascolto`,
          'Racconto audio da ascoltare liberamente',
          'Italiano, inglese e tedesco dove disponibile',
          'Link permanente, tuo per sempre',
          'Ascolto offline disponibile dopo il download',
        ]}
      />
      <PriceCard
        product="tris"
        lang="it"
        features={[
          '3 guide a scelta tra tutte le destinazioni',
          "Risparmi €2,98 rispetto all'acquisto singolo",
          'Accesso illimitato, per sempre',
        ]}
      />
      {zoneBundle && (
        <PriceCard
          product={zoneBundle}
          lang="it"
          primary
          features={[
            'Tutte le 6 guide della zona',
            'Risparmi €9,95 vs guide singole',
            'Aggiornamenti gratuiti quando esce nuovo contenuto della zona',
          ]}
        />
      )}
    </aside>
  </article>
</Layout>
