---
export const prerender = true;
import Layout from '../components/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PriceCard from '../components/PriceCard.astro';
import StepsBlock from '../components/StepsBlock.astro';
import LangPills from '../components/LangPills.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HeroAudioSample from '../components/HeroAudioSample.astro';
---
<Layout
  title="Matera Audioguida | I Sassi Raccontati da Localis"
  description="Esplora Matera con un'audioguida chiara e coinvolgente attraverso i Sassi, le case-grotta, i rioni storici e le storie dietro una delle città più straordinarie del Sud Italia."
  lang="it"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Matera' }]} />

  {/* HERO */}
  <section class="matera-hero relative overflow-hidden border-b border-border">
<img
      src="/images/covers/matera-golden-hour-jun26.webp"
      alt="Matera, i Sassi visti dall'alto con la Gravina sullo sfondo"
      class="matera-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="matera-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="it" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md mt-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Audioguida Localis · Matera
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[24ch]">
        Matera non si visita soltanto.<br />
        <em class="not-italic">Si comprende.</em>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Un'audioguida per attraversare i Sassi, le case-grotta, la Gravina e la storia di una città scavata nella pietra: poverissima, abbandonata, poi rinata davanti al mondo.
      </p>
<HeroAudioSample lang="it" src="/audio/trailers/matera/matera-trailer-it.mp3" guideSlug="matera" />
      <div class="mt-lg flex flex-col sm:flex-row items-start sm:items-center gap-sm">
        <a
          href="/guide/matera"
          class="inline-flex items-center gap-sm px-lg py-sm font-body font-semibold text-sm text-ink border border-ink rounded-md hover:bg-ink hover:text-surface transition-colors duration-fast no-underline"
        >
          Acquista la guida — €4,99
        </a>
      </div>
      <p class="font-body text-xs text-ink-subtle mt-md tracking-[0.06em]">
        1 ora circa · ascolto dal telefono · nessuna app da installare
      </p>
    </div>
  </section>

  <style>
    .matera-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .matera-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.88) contrast(1.06);
    }
    .matera-hero .text-ink,
    .matera-hero h1 {
      color: oklch(12% 0.005 240) !important;
    }
    .matera-hero .text-ink-muted,
    .matera-hero p {
      color: oklch(22% 0.008 240 / 0.9) !important;
    }
    .matera-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.85) 35%,
        oklch(from var(--color-surface) l c h / 0.45) 62%,
        oklch(from var(--color-surface) l c h / 0) 85%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .matera-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.78) 0%,
          oklch(from var(--color-surface) l c h / 0.58) 60%,
          oklch(from var(--color-surface) l c h / 0.35) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Un racconto · una città · millenaria</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* SECTION 1 — PERCHÉ ASCOLTARLA */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="prose-matera max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Perché ascoltarla</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink mb-md font-medium">
          Matera è bellissima anche senza sapere nulla.<br />
          Ma senza una storia rischia di restare solo una scenografia.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Questa guida ti aiuta a leggere quello che hai davanti: le abitazioni scavate nel tufo, le scale, le cisterne, le chiese rupestri, il rapporto con la Gravina, la vita dura nei Sassi e la trasformazione che ha riportato Matera al centro dell'attenzione mondiale.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">Non è una visita guidata piena di date.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
          È un racconto chiaro, umano, pensato per farti camminare con più consapevolezza.
        </p>
      </div>
    </div>
  </section>

  {/* SECTION 2 — COSA ASCOLTERAI */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Cosa ascolterai</span>
      </div>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xl max-w-[60ch]">
        Durante il percorso scoprirai:
      </p>
      <ul class="matera-list list-none p-0 m-0 max-w-[60ch] flex flex-col gap-md">
        {[
          'perché i Sassi non sono semplicemente "case antiche"',
          'come si viveva davvero nelle case-grotta',
          'la differenza tra Sasso Caveoso e Sasso Barisano',
          'il legame profondo tra Matera e la Gravina',
          'il ruolo delle chiese rupestri e della Murgia',
          'perché Matera fu chiamata "vergogna nazionale"',
          'come una città dimenticata è diventata simbolo culturale del Sud Italia',
        ].map((item) => (
          <li class="flex items-start gap-sm font-body text-base sm:text-lg text-ink-muted leading-relaxed">
            <span class="text-accent flex-shrink-0 mt-1 text-sm">✦</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* SECTION 3 — A CHI È PENSATA */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="prose-matera max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">A chi è pensata</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Questa audioguida è per chi arriva a Matera e non vuole limitarsi alle fotografie.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          È per chi vuole camminare, fermarsi, guardare una porta scavata nella roccia, una scala consumata, una casa vuota, e capire che lì dentro non c'è solo bellezza: c'è vita, fatica, memoria, riscatto.
        </p>
        <p class="font-body text-sm text-ink-subtle leading-relaxed italic">
          Perfetta se visiti Matera per la prima volta, se hai poche ore a disposizione o se vuoi vivere i Sassi con più profondità.
        </p>
      </div>
    </div>
  </section>

  {/* SECTION 4 — COME FUNZIONA */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Come funziona</span>
      </div>
      <div class="prose-matera max-w-[68ch] mb-xl">
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">Nessun gruppo.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">Nessun orario.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">Nessuna app complicata.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
          Ascolti dal tuo telefono, con le cuffie, quando vuoi. Puoi fermarti, riprendere, cambiare strada, sederti davanti a un panorama e continuare il racconto con i tuoi tempi.
        </p>
      </div>
    </div>
  </section>

  {/* SECTION 5 — LA PROMESSA DI LOCALIS */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="prose-matera max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">La promessa di Localis</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Localis non crea audioguide per spuntare monumenti da una lista.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Raccontiamo i luoghi attraverso memoria, contesto e vita quotidiana. Ti aiutiamo a capire quello che guardi, senza trasformare la città in una lezione fredda o in una cartolina turistica.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
          Con Matera, questo significa entrare in una storia fatta di pietra, silenzio, povertà, dignità e rinascita.
        </p>
      </div>
    </div>
  </section>

  {/* NARRATORE — ROSA */}
  <section class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">La voce di Matera</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <div class="narr-solo max-w-[38rem] mx-auto">
        <a href="/guide/matera" class="narr-solo-card" aria-label="Guida Matera — voce di Rosa">
          <figure class="narr-solo-photo m-0">
<img
              src="/images/authors/rosa-matera-jun26.png"
              alt="Ritratto narrativo di Rosa"
              title="Rosa: ritratto narrativo costruito su ricerca e fonti Localis."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p class="font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0 mt-xs">
            Ritratto narrativo. Costruito su ricerca e fonti Localis.
          </p>
          <div class="narr-solo-text mt-md">
            <p class="font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">Matera</p>
            <h3 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,1.9rem)] m-0 leading-[1.1]">Rosa</h3>
            <p class="font-body text-xs text-ink-subtle m-0">Voce narrativa dei Sassi</p>
            <p class="font-body text-sm text-ink-muted m-0 mt-xs leading-relaxed">
              Cresciuta a pochi passi dai Sassi. Ha visto Matera trasformarsi da luogo di vergogna a capitale europea della cultura. Racconta la città come chi la porta dentro, non come chi la spiega dall'esterno.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .narr-solo-card {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      text-decoration: none;
      color: inherit;
      border-top: 1px solid var(--color-ink);
      padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-solo-card:hover { opacity: 0.82; }
    .narr-solo-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
    .narr-solo-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-solo-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    @media (prefers-reduced-motion: reduce) { .narr-solo-card { transition: none; } }
  </style>

  {/* PRICING */}
  <section id="prezzi" class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Cammina tra Matera con consapevolezza." />
      <p class="font-body text-sm text-ink-muted text-center max-w-[50ch] mx-auto mb-2xl">
        Inizia con l'anteprima, poi continua tutta la storia.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[44rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="matera"
          lang="it"
          primary
          titleOverride="Audioguida di Matera"
          descriptionOverride="I Sassi, la Gravina, le chiese rupestri. Un racconto unico."
          ctaOverride="Acquista l'audioguida di Matera"
          features={[
            'ascolto immediato dal telefono',
            'racconto completo dei Sassi e della città antica',
            'percorso libero, senza gruppo',
            'accesso sempre disponibile dopo l\'acquisto',
          ]}
        />
        <PriceCard
          product="tris"
          lang="it"
          descriptionOverride="Scegli 3 audioguide e risparmia. Ideale se vuoi scoprire più luoghi della Puglia e del Sud Italia con lo stesso stile: racconti chiari, autentici e ascoltabili dal telefono."
          ctaOverride="Scegli il Pack 3 Guide"
          features={[
            '3 guide a scelta tra tutte le zone',
            'Accesso illimitato, per sempre',
            'Rimborso 1-click entro 24h',
          ]}
        />
      </div>
    </div>
  </section>

  {/* 3 PASSI */}
  <StepsBlock lang="it" ctaHref="/guide/matera" />

</Layout>
