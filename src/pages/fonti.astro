---
export const prerender = true;
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';

const sources = (await getCollection('sources')).sort((a, b) =>
  a.data.guide_title_it.localeCompare(b.data.guide_title_it),
);

function formatDate(d: Date): string {
  return d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
}

function formatSource(s: { author?: string; title: string; publisher?: string; year?: number; }): string {
  const parts: string[] = [];
  if (s.author) parts.push(s.author);
  parts.push(s.title);
  const tail: string[] = [];
  if (s.publisher) tail.push(s.publisher);
  if (s.year) tail.push(String(s.year));
  if (tail.length) parts.push(tail.join(', '));
  return parts.join(' · ');
}
---
<Layout
  title="Le fonti delle guide · Localis"
  description="Le nostre fonti archivistiche e accademiche, raccontate capitolo per capitolo."
  lang="it"
>
  <article class="max-w-wrap mx-auto px-md py-2xl">
    <header class="mb-3xl">
      <p class="text-[11px] font-semibold tracking-[0.32em] uppercase text-accent mb-sm">Verifica le storie</p>
      <h1 class="font-display text-4xl sm:text-5xl text-ink leading-tight mb-md">Le fonti delle guide.</h1>
      <p class="font-display italic text-xl text-ink-muted leading-snug max-w-prose">
        Qui non trovi solo bibliografia: trovi il processo di ricerca che rende affidabili i racconti.
      </p>
    </header>

    <section class="mb-3xl rounded-xl border border-border bg-surface-deep p-lg">
      <p class="text-base text-ink-muted leading-relaxed max-w-prose">
        Ogni guida nasce da ricerca e fonti dichiarate. Dove utilizziamo memoria orale raccolta sul territorio, lo indichiamo; dove il racconto ricostruisce una scena o una voce narrativa, lo dichiariamo come tale.
      </p>
    </section>

    {sources.map((entry) => (
      <section class="mb-3xl pt-xl border-t border-border">
        <header class="mb-md">
          <h2 class="font-display text-3xl text-ink leading-tight mb-xs">{entry.data.guide_title_it}</h2>
          <p class="text-xs font-semibold tracking-[0.22em] uppercase text-ink-subtle">
            Ultima revisione: {formatDate(entry.data.last_review)}
          </p>
        </header>

        <p class="text-base text-ink-muted leading-relaxed max-w-prose mb-lg">
          {entry.data.research_note_it ?? 'Per questa guida abbiamo incrociato testi storici, archivi e verifiche sul posto per ridurre ogni semplificazione turistica.'}
        </p>

        {entry.data.chapters.map((chapter) => (
          <article class="mb-xl rounded-lg border border-border/80 bg-surface p-md">
            <h3 class="font-display text-xl text-ink mb-xs">{chapter.title_it}</h3>
            <p class="text-sm text-ink mb-sm">
              {chapter.framing_it ?? 'Cosa dimostriamo in questo capitolo:'}
            </p>

            {chapter.facts.map((fact) => (
              <div class="mb-md">
                <p class="text-sm italic text-ink-muted mb-xs">{fact.claim_it}</p>
                <ul class="list-disc pl-lg space-y-2xs">
                  {fact.sources.map((source) => (
                    <li class="text-sm text-ink-muted leading-snug">
                      {source.url
                        ? <a href={source.url} target="_blank" rel="noopener noreferrer">{formatSource(source)}</a>
                        : formatSource(source)}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </section>
    ))}
  </article>
</Layout>
