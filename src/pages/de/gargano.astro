        {[
          { name: 'Rossella', photo: '/images/authors/rossella-vieste.jpg', role: 'Dritte Generation Strandclub, Vieste', bio: "VierundfÃ¼nfzig. Ihre Familie fÃ¼hrt denselben Strandclub seit GroÃŸvaters Zeiten. Sie hat diese KÃ¼ste in sechzig Jahren mehr verÃ¤ndern sehen als in den sechshundert davor.", guide: 'Vieste', href: '/de/guide/gargano-vieste' },
