          { name: "Fra' Salvatore", photo: '/images/authors/fra-salvatore-sacro.jpg', role: 'DreiÃŸig Jahre am Heiligtum von Monte Sant\'Angelo', bio: "Dreiundsiebzig. FranziskanermÃ¶nch seit 1978. Er hat Pilger von der Foresta Umbra bis zur Grottenkirche des Erzengels gefÃ¼hrt â€” zu FuÃŸ, wie im Mittelalter.", guide: 'Heiliger Gargano', href: '/de/guide/gargano-sacro' },
