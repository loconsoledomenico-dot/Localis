---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const sources = (await getCollection('sources')).sort((a, b) =>
  (a.data.guide_title_de ?? a.data.guide_title_en).localeCompare(b.data.guide_title_de ?? b.data.guide_title_en),
);

function formatDate(d: Date): string {
  return d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
}

function formatSource(s: { author?: string; title: string; publisher?: string; year?: number; }): string {
  const parts: string[] = [];
  if (s.author) parts.push(s.author);
  parts.push(s.title);
  const tail: string[] = [];
  if (s.publisher) tail.push(s.publisher);
  if (s.year) tail.push(String(s.year));
  if (tail.length) parts.push(tail.join(', '));
  return parts.join(' · ');
}
---
<Layout
  title="Quellen der Guides · Localis"
  description="Archiv- und Fachquellen hinter den Localis Guides, Kapitel fur Kapitel."
  lang="de"
>
  <article class="max-w-wrap mx-auto px-md py-2xl">
    <header class="mb-3xl">
      <p class="text-[11px] font-semibold tracking-[0.32em] uppercase text-accent mb-sm">Prufe die Geschichten</p>
      <h1 class="font-display text-4xl sm:text-5xl text-ink leading-tight mb-md">Unsere Quellen.</h1>
      <p class="font-display italic text-xl text-ink-muted leading-snug max-w-prose">
        Keine kalte Literaturliste: hier siehst du den Rechercheweg hinter jeder Guide.
      </p>
    </header>

    <section class="mb-3xl rounded-xl border border-border bg-surface-deep p-lg">
      <p class="text-base text-ink-muted leading-relaxed max-w-prose">
        Jede Guide basiert auf prufbaren Quellen, Vor-Ort-Kontrollen und lokaler Erinnerung. Nicht belegbare Details markieren wir als narrative Rekonstruktion.
      </p>
    </section>

    {sources.map((entry) => (
      <section class="mb-3xl pt-xl border-t border-border">
        <header class="mb-md">
          <h2 class="font-display text-3xl text-ink leading-tight mb-xs">{entry.data.guide_title_de ?? entry.data.guide_title_en}</h2>
          <p class="text-xs font-semibold tracking-[0.22em] uppercase text-ink-subtle">
            Letzte Prufung: {formatDate(entry.data.last_review)}
          </p>
        </header>

        <p class="text-base text-ink-muted leading-relaxed max-w-prose mb-lg">
          {entry.data.research_note_de ?? entry.data.research_note_en ?? 'Fur diese Guide wurden historische Texte, Archive und Ortsbegehungen gegengepruft, um vereinfachte Touristenerzahlungen zu vermeiden.'}
        </p>

        {entry.data.chapters.map((chapter) => (
          <article class="mb-xl rounded-lg border border-border/80 bg-surface p-md">
            <h3 class="font-display text-xl text-ink mb-xs">{chapter.title_de ?? chapter.title_en ?? chapter.title_it}</h3>
            <p class="text-sm text-ink mb-sm">{chapter.framing_de ?? chapter.framing_en ?? 'Was dieses Kapitel belegt:'}</p>

            {chapter.facts.map((fact) => (
              <div class="mb-md">
                <p class="text-sm italic text-ink-muted mb-xs">{fact.claim_de ?? fact.claim_en ?? fact.claim_it}</p>
                <ul class="list-disc pl-lg space-y-2xs">
                  {fact.sources.map((source) => (
                    <li class="text-sm text-ink-muted leading-snug">
                      {source.url
                        ? <a href={source.url} target="_blank" rel="noopener noreferrer">{formatSource(source)}</a>
                        : formatSource(source)}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </section>
    ))}
  </article>
</Layout>
