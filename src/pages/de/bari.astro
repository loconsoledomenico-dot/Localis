---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import BariMap from '../../components/BariMap.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import AuthorsBlock from '../../components/AuthorsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import LangPills from '../../components/LangPills.astro';
---
<Layout
  title="Bari — Narrative Audioguides · Localis"
  description="Sechs narrative Audioguides aus Bari, erzählt von Bariser Autoren. Altstadt, San Nicola, Hafen, Theater, Unterstadt, Das Beste von Bari. Ab €4,99."
  lang="de"
>

  {/* PAGE HEADER — hero with image */}
  <section class="bari-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/hero/hero-bari-tramonto.jpg"
      alt="Bari, Blick auf die Altstadt und die Strandpromenade"
      class="bari-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="bari-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="de" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Reiseziel — Bari
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[18ch]">
        Bari erzählt<br /><em class="not-italic text-ink-muted">von denen, die dort geboren wurden.</em>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Sechs Live-Guides, sechs Bariser Stimmen. Von der Altstadt bis zum Hafen, von den Theatern bis zur Unterstadt — jede Route stammt von jemandem, der dort aufgewachsen ist.
      </p>
    </div>
  </section>

  <style>
    .bari-hero {
      min-height: clamp(280px, 42vh, 480px);
      display: flex;
      align-items: center;
    }
    .bari-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .bari-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.88) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 35%,
        oklch(from var(--color-surface) l c h / 0.18) 70%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .bari-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.72) 60%,
          oklch(from var(--color-surface) l c h / 0.5) 100%
        );
      }
    }
  </style>

  {/* THE 6 GUIDES */}
  <BariMap lang="de" />

  {/* PRICING */}
  <section id="preise" class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Nimm was du brauchst" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="bari-vecchia"
          lang="de"
          features={[
            'Ein Guide nach Wahl',
            'Unbegrenzter Zugang, für immer',
            'Italienisch, Englisch und Deutsch',
            '1-Klick-Rückgabe innerhalb 24h',
          ]}
        />
        <PriceCard
          product="essenziale"
          lang="de"
          features={[
            'Altstadt · San Nicola · Das Beste von Bari',
            '~1h 20min · 3 verschiedene Stimmen',
            'Italienisch, Englisch und Deutsch',
            '1-Klick-Rückgabe innerhalb 24h',
          ]}
        />
        <PriceCard
          product="bundle"
          lang="de"
          primary
          features={[
            'Alle 6 Bari-Guides',
            '~2h 20min · 6 verschiedene Stimmen',
            'Spart €14,95 gegenüber Einzelkauf',
            '1-Klick-Rückgabe innerhalb 24h',
          ]}
        />
      </div>
    </div>
  </section>

  {/* AUTHORS */}
  <AuthorsBlock lang="de" />

  {/* 3 STEPS */}
  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />

</Layout>
