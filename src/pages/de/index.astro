---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import Hero from '../../components/Hero.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import DestinationsBlock from '../../components/DestinationsBlock.astro';
import GuideBuilder from '../../components/GuideBuilder.astro';
---
<Layout
  title="Localis — Narrative Audioguides · Apulien"
  description="Narrative Audioguides aus Bari und Apulien. Erzählt von Einheimischen. Keine App nötig. Ab €4,99."
  lang="de"
>
  <Hero lang="de" currentPath={Astro.url.pathname} />

  <StatsBlock lang="de" />

  <FeatureBlock
    eyebrow="Geschichten · Autoren"
    heading="Jede Stimme hat einen Namen."
    body="Unsere Guides werden von echten Einheimischen erzählt — Leuten, die dort geboren wurden und aufgewachsen sind. Keine Schauspieler, keine Skripte von Reiseagenturen."
    imageSrc="/images/feature/autori-bari.jpg"
    imageAlt="Autoren aus Bari"
    bullets={[]}
    ctaLabel="Guides entdecken"
    ctaHref="/de/guide"
  />

  <DestinationsBlock lang="de" />

  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />

  {/* BUILDER */}
  <GuideBuilder lang="de" />

  {/* BARI COMPLETA */}
  <section class="bg-surface-elev border-y border-border" id="preise">
    <div class="max-w-wrap mx-auto px-md py-2xl">
      <SectionDivider label="Sonderausgabe — Nur Bari" />
      <div class="max-w-sm mx-auto">
        <PriceCard
          product="bari-completa"
          lang="it"
          features={[
            'Alle 6 Bari-Guides',
            '~2h 20min Erzählung · 6 verschiedene Stimmen',
            'Italienisch und Englisch',
            'Spare €14,95 gegenüber Einzelguides',
            '1-Klick-Rückerstattung innerhalb 24h',
          ]}
          primary
        />
      </div>
    </div>
  </section>


</Layout>
