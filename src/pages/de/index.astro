---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import Hero from '../../components/Hero.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import DestinationsBlock from '../../components/DestinationsBlock.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
---
<Layout
  title="Localis — Narrative Audioguides · Apulien"
  description="Narrative Audioguides aus Bari und Apulien. Erzählt von Einheimischen. Keine App nötig. Ab €4,99."
  lang="de"
>
  <Hero lang="de" currentPath={Astro.url.pathname} />

  <StatsBlock lang="de" />

  <FeatureBlock
    eyebrow="Geschichten · Autoren"
    heading="Jede Stimme hat einen Namen."
    body="Unsere Guides werden von echten Einheimischen erzählt — Leuten, die dort geboren wurden und aufgewachsen sind. Keine Schauspieler, keine Skripte von Reiseagenturen."
    imageSrc="/images/feature/autori-bari.jpg"
    imageAlt="Autoren aus Bari"
    bullets={[]}
    ctaLabel="Guides entdecken"
    ctaHref="/de/guide"
  />

  <DestinationsBlock lang="de" />

  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />

  <section id="preise" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Nimm was du brauchst" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[46rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="bari-vecchia"
          lang="de"
          features={[
            'Ein Guide nach Wahl',
            'Unbegrenzter Zugang, für immer',
            'Italienisch, Englisch und Deutsch',
            '1-Klick-Rückgabe innerhalb 24h',
          ]}
        />
        <PriceCard
          product="bundle"
          lang="de"
          primary
          features={[
            'Alle verfügbaren Guides · Bari + Valle d\'Itria',
            '~3h Storytelling · verschiedene Stimmen',
            '1-Klick-Rückgabe innerhalb 24h',
          ]}
        />
      </div>
    </div>
  </section>

  <MobileStickyCTA lang="de" />

</Layout>
