---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import Hero from '../../components/Hero.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import DestinationsBlock from '../../components/DestinationsBlock.astro';
---
<Layout
  title="Localis — Narrative Audioguides · Apulien"
  description="Narrative Audioguides aus Bari und Apulien. Erzählt von Einheimischen. Keine App nötig. Ab €4,99."
  lang="de"
>
  <Hero lang="de" currentPath={Astro.url.pathname} />

  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-lg grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-lg items-start">
      <div>
        <p class="text-xs font-semibold tracking-[0.24em] uppercase text-accent mb-xs">
          Self-guided Audiotouren
        </p>
        <p class="font-display text-2xl text-ink leading-tight m-0">
          Starte an einem echten Ort, höre Kapitel für Kapitel und geh in deinem Tempo.
        </p>
      </div>
      <p class="text-base text-ink-muted leading-relaxed m-0">
        Jeder Guide verbindet eine praktische Route, lokale Erzählung und überprüfbare Quellen. Keine App: Du erhältst einen dauerhaften Link und hörst vor, während oder nach der Reise.
      </p>
    </div>
  </section>

  <StatsBlock lang="de" />

  <FeatureBlock
    eyebrow="Geschichten · Autoren"
    heading="Jede Stimme hat einen Namen."
    body="Unsere Guides werden von echten Einheimischen erzählt — Leuten, die dort geboren wurden und aufgewachsen sind. Keine Schauspieler, keine Skripte von Reiseagenturen."
    imageSrc="/images/covers/scrivania-ricerca.jpg"
    imageAlt="Recherche-Schreibtisch mit Notizen und Buechern ueber Bari"
    bullets={[]}
    ctaLabel="Guides entdecken"
    ctaHref="/de/guide"
  />

  <DestinationsBlock lang="de" />

  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />

  {/* CTA → Builder auf /de/guide */}
  <section class="bg-surface" id="preise">
    <div class="max-w-wrap mx-auto px-md py-2xl text-center">
      <p class="font-display font-light text-[clamp(1.2rem,2.5vw,1.7rem)] text-ink mb-md">
        3, 6 oder alle 18 Guides?
      </p>
      <div class="flex flex-col items-center gap-sm">
        <a
          href="/de/guide#builder"
          class="inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
        >
          Paket zusammenstellen
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="text-sm text-ink-muted">Tris €11,99 · Sestina €19,99 · Puglia Completa €39,99</p>
      </div>
    </div>
  </section>


</Layout>
