---
/**
 * Blog-Artikel — Deutsche Version.
 * URL: localis.guide/de/blog/[slug]/
 *
 * Artikel hinzufügen: src/content/blog/[slug].mdx mit lang: de erstellen.
 */
export const prerender = true;

import { getCollection, render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import BlogCtaBox from '../../../components/BlogCtaBox.astro';
import StructuredData from '../../../components/StructuredData.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', (e) =>
    e.data.lang === 'de' && e.data.status === 'published'
  );
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const SITE = 'https://localis.guide';

const langUrlsOverride = {
  it: `/blog/${d.slug_it}/`,
  en: `/en/blog/${d.slug_en}/`,
  de: `/de/blog/${d.slug}/`,
};

const allDe = await getCollection('blog', (e) => e.data.lang === 'de' && e.data.status === 'published');
const related = allDe.filter((a) => d.related.includes(a.data.slug)).slice(0, 3);

const articleLD = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  image: `${SITE}${d.cover}`,
  datePublished: d.published_at.toISOString().split('T')[0],
  ...(d.updated_at && { dateModified: d.updated_at.toISOString().split('T')[0] }),
  inLanguage: 'de-DE',
  author: { '@type': 'Organization', name: 'Localis', url: SITE },
  publisher: {
    '@type': 'Organization',
    name: 'Localis',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE}/de/blog/${d.slug}/` },
};

const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',       item: `${SITE}/de/` },
    { '@type': 'ListItem', position: 2, name: d.zone_label, item: `${SITE}/de${d.zone_href}` },
    { '@type': 'ListItem', position: 3, name: 'Blog',       item: `${SITE}/de/blog/` },
    { '@type': 'ListItem', position: 4, name: d.title,      item: `${SITE}/de/blog/${d.slug}/` },
  ],
};
---

<Layout
  title={`${d.title} · Localis`}
  description={d.description}
  lang="de"
  ogImage={d.cover}
  ogType="article"
  langUrlsOverride={langUrlsOverride}
>
  <StructuredData data={articleLD} />
  <StructuredData data={breadcrumbLD} />

  <nav aria-label="Breadcrumb" class="max-w-narrow mx-auto px-md pt-lg">
    <ol class="flex items-center gap-xs text-sm text-ink-subtle flex-wrap">
      <li><a href="/de/" class="hover:text-ink transition-colors">Home</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li><a href={`/de${d.zone_href}`} class="hover:text-ink transition-colors">{d.zone_label}</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li><a href="/de/blog/" class="hover:text-ink transition-colors">Blog</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li aria-current="page" class="text-ink-muted truncate max-w-[18ch]">{d.title}</li>
    </ol>
  </nav>

  <header class="max-w-narrow mx-auto px-md pt-xl pb-lg">
    <p class="text-xs font-semibold tracking-[0.20em] uppercase text-accent mb-sm">
      {d.zone_label} · Historischer Hintergrundbericht
    </p>
    <h1 class="font-display text-4xl text-ink leading-tight mb-md">{d.title}</h1>
    <p class="text-lg text-ink-muted leading-relaxed">{d.description}</p>
    <p class="text-sm text-ink-subtle mt-md">
      Veröffentlicht am
      <time datetime={d.published_at.toISOString().split('T')[0]}>
        {d.published_at.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
    </p>
  </header>

  <div class="max-w-narrow mx-auto px-md mb-xl">
    <img
      src={d.cover}
      alt={d.cover_alt}
      width={d.cover_width}
      height={d.cover_height}
      loading="eager"
      decoding="async"
      class="w-full rounded-lg object-cover"
      style={`aspect-ratio: ${d.cover_width}/${d.cover_height}`}
    />
  </div>

  <div class="max-w-narrow mx-auto px-md">
    <BlogCtaBox lang="de" guideSlug={d.guide_slug} guideTitle={d.guide_title} guideProduct={d.guide_product} guidePriceLabel={d.guide_price_label} />
  </div>

  <article class="max-w-narrow mx-auto px-md prose-blog">
    <Content />
  </article>

  <div class="max-w-narrow mx-auto px-md">
    <BlogCtaBox lang="de" guideSlug={d.guide_slug} guideTitle={d.guide_title} guideProduct={d.guide_product} guidePriceLabel={d.guide_price_label} />
  </div>

  {related.length > 0 && (
    <section class="max-w-narrow mx-auto px-md py-2xl border-t border-border mt-xl">
      <h2 class="font-display text-2xl text-ink mb-lg">Auch lesen</h2>
      <ul class="grid sm:grid-cols-2 gap-md" role="list">
        {related.map((rel) => (
          <li>
            <a href={`/de/blog/${rel.data.slug}/`} class="group flex flex-col gap-xs p-md rounded-lg border border-border hover:border-accent/40 hover:bg-surface-elev transition-colors no-underline">
              <span class="text-xs font-semibold tracking-[0.16em] uppercase text-accent">{rel.data.zone_label}</span>
              <span class="font-display text-lg text-ink leading-snug group-hover:text-accent/90 transition-colors">{rel.data.title}</span>
              <span class="text-sm text-ink-muted line-clamp-2">{rel.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <aside class="max-w-narrow mx-auto px-md pb-3xl">
    <p class="text-sm text-ink-muted">
      Planen Sie einen Besuch?
      <a href={`/de/guide/${d.guide_slug}/`} class="text-link hover:text-link-pressed underline underline-offset-2">
        Entdecken Sie den Audio-Guide {d.guide_title}
      </a>
      — dreißig Minuten Originalerzählung, auch offline verfügbar.
    </p>
  </aside>
</Layout>

<style>
  .prose-blog { color: var(--color-ink-muted); line-height: 1.75; font-size: var(--text-base); }
  .prose-blog :global(p) { margin-bottom: var(--spacing-lg); }
  .prose-blog :global(h2) { font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-ink); margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-md); line-height: 1.25; }
  .prose-blog :global(h3) { font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-ink); margin-top: var(--spacing-xl); margin-bottom: var(--spacing-sm); line-height: 1.3; }
  .prose-blog :global(strong) { color: var(--color-ink); font-weight: 600; }
  .prose-blog :global(em) { font-style: italic; }
  .prose-blog :global(a) { color: var(--color-link); text-underline-offset: 3px; }
  .prose-blog :global(a:hover) { color: var(--color-link-pressed); }
  .prose-blog :global(img) { width: 100%; border-radius: var(--radius-md); margin-block: var(--spacing-xl); }
  .prose-blog :global(blockquote) { border-left: 3px solid var(--color-accent); padding-left: var(--spacing-lg); margin-left: 0; color: var(--color-ink); font-family: var(--font-display); font-style: italic; font-size: var(--text-lg); }
  .prose-blog :global(ul), .prose-blog :global(ol) { padding-left: var(--spacing-lg); margin-bottom: var(--spacing-lg); }
  .prose-blog :global(li) { margin-bottom: var(--spacing-xs); }
</style>
