---
export const prerender = true;
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import StatsBlock from '../components/StatsBlock.astro';
import StepsBlock from '../components/StepsBlock.astro';
import DestinationsBlock from '../components/DestinationsBlock.astro';
---
<Layout
  title="Localis | Audioguide narrative per capire Bari e la Puglia"
  description="Racconti audio documentati di Bari, Valle d'Itria e Gargano. Ascolta 1 minuto gratis, acquista dal telefono e salva offline per la visita."
  lang="it"
>
  <Hero lang="it" currentPath={Astro.url.pathname} />

  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-lg grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-lg items-start">
      <div>
        <p class="text-xs font-semibold tracking-[0.24em] uppercase text-accent mb-xs">
          Racconti audio dei luoghi
        </p>
        <p class="font-display text-2xl text-ink leading-tight m-0">
          Non ti dicono dove andare: ti fanno capire dove sei.
        </p>
      </div>
      <p class="text-base text-ink-muted leading-relaxed m-0">
        Localis è un racconto audio del luogo: storie, contesto e prospettive dichiarate per capire come quel posto è diventato ciò che è oggi. Nessuna app: ricevi un link, premi play e ascolti quando vuoi.
      </p>
    </div>
  </section>

  {/* STATS — banda sottile, separa l'hero dal resto: 6/0/0/∞ */}
  <StatsBlock lang="it" />

  {/* FEATURE BLOCK — Storie firmate (image left — alterna con Hero che ha foto a destra) */}
  <FeatureBlock
    eyebrow="Ricerca · Metodo — Tav. III"
    heading="Scritte in Puglia."
    italicEnding="Con fonti verificabili."
    body="Ogni guida nasce da ricerca editoriale: fonti storiche, fonti istituzionali e, quando presente, memoria locale raccolta sul territorio. Nella pagina Fonti pubblichiamo i riferimenti utilizzati per costruire i racconti."
    bullets={[
      "Fonti accademiche · Treccani, DBI, Houben, Abulafia, Cioffari",
      "Guide pubblicate · Bari, Valle d’Itria, Gargano",
      "Italiano, inglese e tedesco · testi curati lingua per lingua",
      "Tutto verificabile · ogni claim su /fonti, capitolo per capitolo",
    ]}
    imageSrc="/images/covers/fonti-ricerca.jpg"
    imageAlt="Scrivania di ricerca: libri di storia barese, taccuino aperto con appunti su Bari Vecchia, cartoline d’epoca della città, mappa storica e quotidiano ‘L’Eco di Bari’ sulle reliquie di San Nicola"
    caption="La scrivania prima della voce. Libri, appunti, cartoline, ritagli — ogni capitolo nasce da qui."
    ctaLabel="Il nostro metodo"
    ctaHref="/metodo"
    imageSide="left"
    tiltDeg={-1.5}
  />

  {/* MANIFESTO — slim, pull-quote tra Tav III e Tav IV */}
  <section class="manifesto-section bg-surface-elev border-y border-border">
    <div class="max-w-narrow mx-auto px-md py-xl lg:py-2xl">
      <p class="text-center text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle mb-md">
        — Manifesto —
      </p>

      <blockquote class="manifesto-quote font-display italic text-ink leading-[1.2] text-[clamp(1.3rem,3vw,1.9rem)] m-0 max-w-[44ch] mx-auto text-center">
        Non solo luoghi da vedere —<br />
        storie per capirli.
      </blockquote>
    </div>
  </section>

  {/* DESTINAZIONI — le 3 zone come card */}
  <DestinationsBlock lang="it" />

  {/* CTA → builder su /guide */}
  <section class="bg-surface" id="prezzi">
    <div class="max-w-wrap mx-auto px-md py-2xl">
      <div class="flex flex-col items-center gap-sm text-center">
      <p class="font-display font-light text-[clamp(1.2rem,2.5vw,1.7rem)] text-ink mb-xs">
        Una guida, un pack o tutta la Puglia.
      </p>
      <div class="flex flex-col items-center gap-sm">
        <a
          href="/guide#builder"
          class="inline-flex items-center justify-center gap-xs px-xl py-md bg-accent text-surface rounded-md font-semibold text-base hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[52px]"
        >
          Costruisci il tuo pacchetto
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="text-sm text-ink-muted">Guida singola €4,99 · Pack 3 Guide €11,99 · Pack 6 Guide €19,99</p>
        <p class="text-xs text-ink-subtle max-w-[42ch] text-center">Pack 6 Guide funziona anche mescolando guide di zone diverse.</p>
      </div>
      </div>
    </div>
  </section>

  {/* FEATURE BLOCK — Si apre con un link (post-pricing reassurance) */}
  <FeatureBlock
    eyebrow="Strumento — Tav. V"
    heading="Poche ore a Bari?"
    italicEnding="Ascolta due racconti selezionati per capire la città senza perdere tempo."
    body="Acquisti con email e carta. Ti arriva un link permanente: lo apri quando vuoi, premi play, ascolti. In strada mentre cammini, sul divano prima di partire, in treno al ritorno. Sono racconti, non audio museali che descrivono ciò che hai davanti — ti portano dentro Bari, anche se non ci sei ancora."
    bullets={[
      'Ascolto libero · sul posto, prima, dopo, ovunque',
      'Magic link via email · zero password, zero account',
      'Link permanente · la guida è tua, riascolti per sempre',
    ]}
    imageSrc="/images/covers/nave-crociera.jpg"
    imageAlt="Gruppo di crocieristi sbarca a Bari davanti alla nave MSC Splendida; lungomare del porto sullo sfondo, sole pieno"
    caption="Bari, porto crociere. Anche con poche ore a terra, è un modo per capire il luogo prima ancora di attraversarlo."
    ctaLabel="Scopri il percorso per crocieristi"
    ctaHref="/crocieristi"
    imageSide="right"
    tiltDeg={1.5}
    mobileAspect="3 / 2"
    framedImage
  />

  {/* 3-PASSI — onboarding chiaro prima della chiusura */}
  <StepsBlock lang="it" ctaHref="/guide/bari-vecchia" />


</Layout>

<style>
  /* Manifesto: leggera comparsa del blockquote alla prima paint */
  .manifesto-quote {
    opacity: 0;
    transform: translateY(10px);
    animation: manifestoIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }
  @keyframes manifestoIn {
    to { opacity: 1; transform: translateY(0); }
  }


  @media (prefers-reduced-motion: reduce) {
    .manifesto-quote {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
