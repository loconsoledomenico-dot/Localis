---
export const prerender = true;
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionDivider from '../components/SectionDivider.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import StatsBlock from '../components/StatsBlock.astro';
import StepsBlock from '../components/StepsBlock.astro';
import DestinationsBlock from '../components/DestinationsBlock.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
---
<Layout
  title="Localis — audioguide narrative di Bari"
  description="Audioguide narrative di Bari che ti fanno capire, non elencare. Sei guide live scritte da chi ci vive. €4,99."
  lang="it"
>
  <Hero lang="it" />

  {/* STATS — banda sottile, separa l'hero dal resto: 6/0/0/∞ */}
  <StatsBlock lang="it" />

  {/* FEATURE BLOCK — Storie firmate (image left — alterna con Hero che ha foto a destra) */}
  <FeatureBlock
    eyebrow="Storie · Autori — Tav. III"
    heading="Storie firmate."
    italicEnding="Da chi le ha vissute."
    body="Ogni capitolo è ricerca d'archivio firmata da autori baresi. Un cortile, un altare laterale, la Bari sotterranea che nessuno conosce — raccontati da chi in quei vicoli ci è cresciuto."
    bullets={[
      'Autori locali · uno per itinerario, firmato con nome e bio',
      'Guide live · Bari, Valle d\'Itria, Gargano in arrivo',
      'Italiano e inglese · scritti separatamente, mai tradotti',
      'Fonti pubbliche · ogni claim verificabile su /fonti',
    ]}
    imageSrc="/images/covers/scrivania-ricerca.jpg"
    imageAlt="Scrivania di ricerca: libri di storia barese, taccuino aperto con appunti su Bari Vecchia, cartoline d'epoca della città, mappa storica e quotidiano ‘L'Eco di Bari' sulle reliquie di San Nicola"
    caption="La scrivania prima della voce. Libri, appunti, cartoline, ritagli — ogni capitolo nasce da qui."
    ctaLabel="Conosci gli autori"
    ctaHref="/about"
    imageSide="left"
    tiltDeg={-1.5}
  />

  {/* MANIFESTO — slim, pull-quote tra Tav III e Tav IV */}
  <section class="manifesto-section bg-surface-elev border-y border-border">
    <div class="max-w-narrow mx-auto px-md py-xl lg:py-2xl">
      <p class="text-center text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle mb-md">
        — Manifesto —
      </p>

      <blockquote class="manifesto-quote font-display italic text-ink leading-[1.2] text-[clamp(1.3rem,3vw,1.9rem)] m-0 max-w-[28ch] mx-auto text-center">
        Le audioguide normali ti dicono&nbsp;cosa.<br />
        Le nostre ti dicono&nbsp;perché.
      </blockquote>
    </div>
  </section>

  {/* DESTINAZIONI — le 3 zone come card */}
  <DestinationsBlock lang="it" />

  {/* PRICING — subito dopo le 6 schede, momento decisione single vs bundle */}
  <section id="prezzi" class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Prendi quella che ti serve" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="bari-vecchia"
          lang="it"
          features={[
            'Una guida a tua scelta',
            'Accesso illimitato, per sempre',
            'Italiano e inglese',
            'Rimborso 1-click entro 24h',
          ]}
        />
        <PriceCard
          product="essenziale"
          lang="it"
          features={[
            'Bari Vecchia · San Nicola · Il Meglio di Bari',
            '~1h 20min di racconto · 3 voci diverse',
            'Italiano e inglese',
            'Rimborso 1-click entro 24h',
          ]}
        />
        <PriceCard
          product="bundle"
          lang="it"
          primary
          features={[
            'Tutte le 6 guide di Bari',
            '~2h 20min di racconto · 6 voci diverse',
            'Risparmi €14,95 vs guide singole',
            'Rimborso 1-click entro 24h',
          ]}
        />
      </div>
    </div>
  </section>

  {/* FEATURE BLOCK — Si apre con un link (post-pricing reassurance) */}
  <FeatureBlock
    eyebrow="Strumento — Tav. V"
    heading="Si apre con un link."
    italicEnding="Ascolti dove vuoi. Niente app."
    body="Acquisti con email e carta. Ti arriva un link permanente: lo apri quando vuoi, premi play, ascolti. In strada mentre cammini, sul divano prima di partire, in treno al ritorno. Sono racconti, non audio museali che descrivono ciò che hai davanti — ti portano dentro Bari, anche se non ci sei ancora."
    bullets={[
      'Ascolto libero · sul posto, prima, dopo, ovunque',
      'Magic link via email · zero password, zero account',
      'Link permanente · la guida è tua, riascolti per sempre',
    ]}
    imageSrc="/images/covers/nave-crociera.jpg"
    imageAlt="Gruppo di crocieristi sbarca a Bari davanti alla nave MSC Splendida; lungomare del porto sullo sfondo, sole pieno"
    caption="Bari, porto crociere. Per loro l'audioguida parte appena tocca la banchina."
    ctaLabel="Vedi le guide"
    ctaHref="#guide"
    imageSide="right"
    tiltDeg={1.5}
    mobileAspect="3 / 2"
    framedImage
  />

  {/* 3-PASSI — onboarding chiaro prima della chiusura */}
  <StepsBlock lang="it" ctaHref="/guide/bari-vecchia" />

  {/* CLOSER */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl text-center">
      <p class="font-display italic text-xl sm:text-2xl text-ink-muted mb-2xs">
        La Puglia si visita in un viaggio.
      </p>
      <p class="font-display text-3xl sm:text-4xl text-ink mb-lg leading-tight">
        Si capisce in capitoli.
      </p>
      <a
        href="/guide"
        class="inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
      >
        Scopri le guide
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <MobileStickyCTA lang="it" />
</Layout>

<style>
  /* Manifesto: leggera comparsa del blockquote alla prima paint */
  .manifesto-quote {
    opacity: 0;
    transform: translateY(10px);
    animation: manifestoIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }
  @keyframes manifestoIn {
    to { opacity: 1; transform: translateY(0); }
  }


  @media (prefers-reduced-motion: reduce) {
    .manifesto-quote {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
