---
export const prerender = true;
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionDivider from '../components/SectionDivider.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import StatsBlock from '../components/StatsBlock.astro';
import StepsBlock from '../components/StepsBlock.astro';
import AuthorsBlock from '../components/AuthorsBlock.astro';
import BariMap from '../components/BariMap.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
---
<Layout
  title="Localis — audioguide narrative di Bari"
  description="Audioguide narrative di Bari che ti fanno capire, non elencare. Quattro guide live scritte da chi ci vive. €4,99."
  lang="it"
>
  <Hero lang="it" />

  {/* FEATURE BLOCK — Storie firmate (image left — alterna con Hero che ha foto a destra) */}
  <FeatureBlock
    eyebrow="Storie · Autori — Tav. II"
    heading="Storie firmate."
    italicEnding="Da chi le ha vissute."
    body="Ogni capitolo è ricerca d'archivio firmata da autori baresi. Un cortile, un altare laterale, l'angolo dove un mercante è morto in piedi — raccontati da chi quei vicoli li ha camminati da bambino."
    bullets={[
      'Tredici capitoli per guida · 1–3 minuti ciascuno',
      'Un autore per quartiere · bio e fonti pubbliche',
      'Italiano e inglese · scritti separatamente',
      'Tono editoriale · zero «mamma mia»',
    ]}
    imageSrc="/images/covers/bari-vecchia-passeggiata.jpg"
    imageAlt="Una donna con cappello di paglia cammina lungo un vicolo del Borgo Antico di Bari, colonne romane antiche sulla sinistra"
    plateNumber="Tav. II"
    caption="Bari Vecchia, mezzogiorno. Le colonne sono tutto ciò che resta di un cortile romano."
    ctaLabel="Conosci gli autori"
    ctaHref="/about"
    imageSide="left"
    tiltDeg={-1.5}
  />

  {/* FEATURE BLOCK — Si apre con un link (image right — alterna con FB II) */}
  <FeatureBlock
    eyebrow="Strumento — Tav. III"
    heading="Si apre con un link."
    italicEnding="Niente app. Niente account."
    body="Apri il link. Premi play. Niente da scaricare, niente account, niente cookie banner. Pensato per passeggeri di crociera senza roaming."
    bullets={[
      'Funziona su iPhone, Android, qualsiasi telefono',
      'Nessuna registrazione, nessuna email obbligatoria',
    ]}
    imageSrc="/images/covers/smartphone-tilt-r.png"
    imageAlt="Smartphone Android in prospettiva inclinata verso destra, con localis.guide aperto e la home di Bari visibile"
    dualPhone={{
      src: "/images/covers/smartphone-tilt-l.png",
      alt: "Stesso smartphone in prospettiva inclinata verso sinistra, localis.guide aperto",
    }}
    plateNumber="Tav. III"
    caption="Aperto da un link. Senza app."
    ctaLabel="Vedi le guide"
    ctaHref="#guide"
    imageSide="right"
    tiltDeg={1.5}
  />

  {/* STATS — numeri onesti, niente vanity metrics */}
  <StatsBlock lang="it" />

  {/* I sei luoghi — griglia foto, l'unica sezione "scegli la guida" della pagina */}
  <BariMap lang="it" />

  {/* PRICING — subito dopo le 6 schede, momento decisione single vs bundle */}
  <section id="prezzi" class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Prendi quella che ti serve" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[56rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="bari-vecchia"
          lang="it"
          features={[
            'Una guida a tua scelta',
            'Accesso illimitato, per sempre',
            'Italiano e inglese',
            'Rimborso 1-click entro 24h',
          ]}
        />
        <PriceCard
          product="bundle"
          lang="it"
          primary
          features={[
            'Bari Vecchia · Porto · San Nicola',
            'Sequenza progettata · ~4h di cammino',
            'Risparmi €4,98',
            'Rimborso 1-click entro 24h',
          ]}
        />
      </div>
    </div>
  </section>

  {/* MANIFESTO — pull-quote editoriale, niente sovrapposizioni */}
  <section class="manifesto-section bg-surface-elev">
    <div class="max-w-narrow mx-auto px-md py-3xl lg:py-4xl">
      <p class="text-center text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle mb-2xl">
        — Manifesto —
      </p>

      <blockquote class="manifesto-quote font-display italic text-ink leading-[1.18] text-[clamp(1.8rem,4.6vw,2.8rem)] m-0 max-w-[28ch] mx-auto text-center">
        Le audioguide normali ti dicono cosa.<br />
        Le nostre ti dicono perché.
      </blockquote>

      <div class="flex items-center justify-center gap-sm my-2xl" aria-hidden="true">
        <span class="block w-8 h-px bg-border"></span>
        <span class="font-display italic text-ink-subtle text-base">✻</span>
        <span class="block w-8 h-px bg-border"></span>
      </div>

      <p class="text-center text-base sm:text-lg leading-relaxed text-ink-muted max-w-[52ch] mx-auto">
        Ti raccontiamo le storie vere dei luoghi — mentre ci stai dentro.
      </p>
    </div>
  </section>

  {/* TAVOLE AUTORI — voci baresi, una per quartiere */}
  <AuthorsBlock lang="it" />

  {/* 3-PASSI — onboarding chiaro prima della chiusura */}
  <StepsBlock lang="it" ctaHref="/guide/bari-vecchia" />

  {/* CLOSER */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl text-center">
      <p class="font-display italic text-xl sm:text-2xl text-ink-muted mb-2xs">
        Bari si visita in un giorno.
      </p>
      <p class="font-display text-3xl sm:text-4xl text-ink mb-lg leading-tight">
        Si capisce in capitoli.
      </p>
      <a
        href="#guide"
        class="inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
      >
        Inizia ad ascoltare
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <MobileStickyCTA lang="it" />
</Layout>

<style>
  /* Manifesto: leggera comparsa del blockquote alla prima paint */
  .manifesto-quote {
    opacity: 0;
    transform: translateY(10px);
    animation: manifestoIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }
  @keyframes manifestoIn {
    to { opacity: 1; transform: translateY(0); }
  }


  @media (prefers-reduced-motion: reduce) {
    .manifesto-quote {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
