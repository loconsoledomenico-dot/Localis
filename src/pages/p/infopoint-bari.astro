---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import PriceCard from '../../components/PriceCard.astro';
import BariMap from '../../components/BariMap.astro';
---

<Layout
  title="6 Racconti Audio di Bari | Localis — InfoPoint"
  description="Bari Vecchia, San Nicola, il porto, il cibo, i teatri e la città sotterranea: sei racconti audio da ascoltare mentre cammini. Nessuna app. Da €4,99."
  lang="it"
  robots="noindex,nofollow"
  langUrlsOverride={{ it: '/p/infopoint-bari/', en: '/en/p/infopoint-bari/', de: '/de/p/infopoint-bari/' }}
>

  {/* ── HERO ── */}
  <section class="infopoint-hero relative overflow-hidden bg-surface">
    <img
      src="/images/hero/hero-bari-tramonto.jpg"
      alt="Bari, veduta del centro storico e del lungomare"
      class="absolute inset-0 w-full h-full object-cover object-center saturate-90"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-surface/90 via-surface/65 to-surface/10 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          6 RACCONTI AUDIO DI BARI
        </span>
      </div>

      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Bari è davanti a te.<br />
        <em class="font-light not-italic text-accent">Capirla è un'altra cosa.</em>
      </h1>

      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Bari Vecchia, San Nicola, il porto, il cibo, i teatri e la città sotterranea: sei racconti audio da ascoltare mentre cammini. Nessuna app.
      </p>

      <div class="mt-lg">
        <HeroAudioSample
          lang="it"
          src="/audio/trailers/bari/bari-vecchia-trailer-it.mp3"
          guideSlug="bari-vecchia"
        />
        <p class="font-body text-xs text-ink-subtle mt-sm max-w-[46ch]">
          Lingue indicate in ogni racconto · Ascolta in streaming oppure salva offline dopo l'acquisto
        </p>
      </div>

      <div class="hero-actions mt-lg">
        <a href="#pack" class="hero-action hero-action-primary">
          Acquista il pack Bari
        </a>
        <a href="#guide" class="hero-action hero-action-secondary">
          Vedi i 6 racconti
        </a>
      </div>
    </div>
  </section>

  {/* ── 6 GUIDE CARD ── */}
  <BariMap lang="it" />

  {/* ── PACK ── */}
  <section id="pack" class="bg-surface-elev border-t border-border py-3xl scroll-mt-20" aria-label="Acquista le guide di Bari">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.6rem,3.5vw,2.4rem)] leading-tight tracking-[-0.01em] mb-xl text-center">
        Scegli quante guide ti servono
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[52rem] mx-auto">
        <PriceCard
          product="tris"
          lang="it"
          features={[
            '3 guide a tua scelta tra tutte le destinazioni',
            'Risparmi 2,98 EUR rispetto all\'acquisto singolo',
            'Accesso illimitato, per sempre',
          ]}
        />
        <PriceCard
          product="bari-completa"
          lang="it"
          primary={true}
          features={[
            'Tutte e 6 le guide di Bari',
            'Bari Vecchia, San Nicola, Porto, Cibo, Teatri, Sotterranea',
            'Accesso illimitato, per sempre',
            'Italiano e inglese (tedesco su Bari Vecchia)',
          ]}
        />
      </div>
    </div>
  </section>

  {/* ── PROVE DI FIDUCIA ── */}
  <section class="bg-surface border-t border-border py-2xl">
    <div class="max-w-narrow mx-auto px-md flex flex-col sm:flex-row gap-xl items-start sm:items-center justify-between">
      <p class="font-body text-sm text-ink-muted leading-relaxed max-w-[42ch]">
        Racconti costruiti attraverso ricerca e fonti Localis.<br />
        Autori reali e ritratti narrativi sono dichiarati in ogni guida.
      </p>
      <div class="flex gap-md flex-shrink-0">
        <a href="/metodo/" class="font-body text-sm font-semibold text-ink underline underline-offset-4 hover:text-accent transition-colors">
          Scopri il metodo
        </a>
        <a href="/fonti/" class="font-body text-sm font-semibold text-ink underline underline-offset-4 hover:text-accent transition-colors">
          Consulta le fonti
        </a>
      </div>
    </div>
  </section>

  {/* ── TRACKING: landing_view + qr_landing_view ── */}
  <script is:inline>
    (function () {
      try {
        var lang = 'it';
        var path = window.location.pathname;
        var utm = {};
        try {
          var params = new URLSearchParams(window.location.search);
          utm = window.localisUtm || JSON.parse(sessionStorage.getItem('localis_utm') || '{}');
          if (params.get('utm_source') || params.get('utm_medium')) {
            utm = {
              utm_source: params.get('utm_source') || undefined,
              utm_medium: params.get('utm_medium') || undefined,
              utm_campaign: params.get('utm_campaign') || undefined,
              utm_content: params.get('utm_content') || undefined,
            };
          }
        } catch (e) {}

        function track(name, params) {
          if (typeof window.localisTrack === 'function') {
            window.localisTrack(name, params);
          } else {
            // Plausible fallback pre-consent
            try { window.plausible && window.plausible(name, { props: params }); } catch (e) {}
          }
        }

        track('landing_view', {
          page: path,
          language: lang,
          source: utm.utm_source || '(direct)',
          campaign: utm.utm_campaign || '',
        });

        if (utm.utm_medium === 'qr') {
          track('qr_landing_view', {
            partner_id: utm.utm_source || '(direct)',
            placement: utm.utm_content || '',
            campaign: utm.utm_campaign || '',
            language: lang,
          });
        }
      } catch (e) {}
    })();
  </script>

</Layout>

<style>
  .infopoint-hero {
    min-height: clamp(480px, 72vh, 760px);
    display: flex;
    align-items: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.72rem 1rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--duration-fast), color var(--duration-fast), border-color var(--duration-fast);
  }

  .hero-action-primary {
    background: var(--color-ink);
    color: var(--color-surface);
    border: 1px solid var(--color-ink);
  }

  .hero-action-primary:hover {
    background: color-mix(in oklab, var(--color-ink) 90%, white 10%);
  }

  .hero-action-secondary {
    background: oklch(from var(--color-surface) l c h / 0.82);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  .hero-action-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-action {
      width: 100%;
    }
  }
</style>
