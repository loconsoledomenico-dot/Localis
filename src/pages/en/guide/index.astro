---
export const prerender = true;
import Layout from '../../../components/Layout.astro';
import SectionDivider from '../../../components/SectionDivider.astro';
import PriceCard from '../../../components/PriceCard.astro';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  duration: string;
  area: string;
  cover: string;
  alt: string;
  price?: string;
  soon?: boolean;
}

const bariGuides: GuideEntry[] = [
  {
    slug: 'bari-vecchia',
    title: 'Old Bari — Inside the City',
    subtitle: 'The ancient quarter, four thousand years of history.',
    duration: '21 min',
    area: 'Old town',
    cover: '/images/covers/bari-vecchia.jpg',
    alt: 'Old Bari alley with ancient Roman columns and historic buildings',
    price: '€4.99',
  },
  {
    slug: 'san-nicola',
    title: 'San Nicola — The Stolen Saint',
    subtitle: 'How the bones of a saint became a city.',
    duration: '30 min',
    area: 'Old town',
    cover: '/images/covers/san-nicola.jpg',
    alt: 'San Nicola procession at dusk before the Basilica',
    price: '€4.99',
  },
  {
    slug: 'il-meglio-di-bari',
    title: 'The Best of Bari — Eat Before You Think',
    subtitle: 'Orecchiette, sgagliozze and Bari focaccia.',
    duration: '29 min',
    area: 'Old town',
    cover: '/images/covers/il-meglio-di-bari.jpg',
    alt: 'The Orecchiette Street in Old Bari, women shaping pasta on wooden tables',
    price: '€4.99',
  },
  {
    slug: 'porto-bari',
    title: 'Port of Bari — Where It All Happened',
    subtitle: 'Crusaders, merchants, migrants.',
    duration: '33 min',
    area: 'Lungomare',
    cover: '/images/covers/porto-bari.jpg',
    alt: 'Aerial view of Bari at sunset, lungomare and tourist marina',
    price: '€4.99',
  },
  {
    slug: 'tre-teatri',
    title: 'The Three Theatres — Fire, Music, Bourgeoisie',
    subtitle: 'The Bari that wanted to become a European city.',
    duration: '28 min',
    area: 'Murat',
    cover: '/images/covers/tre-teatri.jpg',
    alt: 'Teatro Margherita of Bari, white Liberty-style building over the sea',
    price: '€4.99',
  },
  {
    slug: 'bari-sotterranea',
    title: 'Underground Bari — What Lies Beneath',
    subtitle: 'Cisterns, catacombs and a buried city.',
    duration: '25 min',
    area: 'Old town',
    cover: '/images/covers/bari-sotterranea-v2.jpg',
    alt: 'Crypt of the Basilica of San Nicola, reused Roman columns and Byzantine mosaics',
    price: '€4.99',
  },
];

const valleItria: GuideEntry[] = [
  {
    slug: 'alberobello',
    title: 'Alberobello — Inside the Trulli',
    subtitle: 'The fiscal story nobody ever told you.',
    duration: '35 min',
    area: 'Itria Valley',
    cover: '/images/covers/alberobello.jpg',
    alt: 'Trulli of Alberobello, Rione Monti',
    price: '€4.99',
  },
  {
    slug: 'locorotondo',
    title: 'Locorotondo — The Round Village',
    subtitle: 'A DOC wine, the cummerse houses, and lavender essential oil.',
    duration: '31 min',
    area: 'Itria Valley',
    cover: '/images/covers/locorotondo.jpg',
    alt: 'Locorotondo, white houses with double-pitched roofs',
    price: '€4.99',
  },
  {
    slug: 'martina-franca',
    title: 'Martina Franca — The Free City',
    subtitle: 'Three hundred years of a dukedom, told by someone who carries it in their blood.',
    duration: '30 min',
    area: 'Itria Valley',
    cover: '/images/covers/martina-franca.jpg',
    alt: 'Palazzo Ducale of Martina Franca, baroque courtyard',
    price: '€4.99',
  },
];
---

<Layout
  title="Guides — Localis · Narrative audio guides of Puglia"
  description="All Localis guides: six Bari itineraries, Itria Valley with Alberobello, Locorotondo and Martina Franca. Narrative audio from the people who live there."
  lang="en"
>
  <div class="max-w-wrap mx-auto px-md py-2xl lg:py-3xl">

    {/* PAGE HEADER */}
    <header class="mb-3xl max-w-[52ch]">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          All guides
        </span>
      </div>
      <h1 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(2rem,5vw,3.2rem)]">
        <span class="font-light">Puglia</span>
        <span class="block font-body font-normal text-ink-muted mt-sm text-[clamp(1.1rem,2.2vw,1.45rem)] leading-relaxed tracking-normal">
          one story at a time.
        </span>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
        Not a catalogue. A collection of voices: Bari locals, Martina descendants, winemakers, farmers. Every guide is written by someone who actually lives there.
      </p>
      <p class="font-body text-sm leading-relaxed text-ink-muted mt-sm">
        Open the link, press play and follow the chapters on location: each guide works like a self-guided audio tour, with local stories and verifiable sources.
      </p>
    </header>

    {/* ——— BARI ——— */}
    <section class="mb-3xl lg:mb-4xl" aria-labelledby="area-bari">
      <div class="flex items-baseline gap-md mb-2xl border-b border-border pb-md">
        <h2 id="area-bari" class="font-display font-light text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink tracking-tight">
          Bari
        </h2>
        <span class="font-body text-sm text-ink-muted">6 live guides</span>
      </div>

      <ol class="guide-grid list-none p-0 m-0">
        {bariGuides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/en/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>

      {/* Bari bundle pricing */}
      <div class="mt-2xl">
        <SectionDivider label="Bari Bundle" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[46rem] mx-auto">
          <PriceCard product="single" guideSlug="bari-vecchia" lang="en" features={['One guide of your choice','Unlimited access, forever','Italian and English','1-click refund within 24h']} />
          <PriceCard product="bari-completa" lang="en" primary features={['All 6 Bari guides','~2h 20min · 6 different voices','Save €9.95 vs single guides','1-click refund within 24h']} />
        </div>
      </div>
    </section>

    {/* ——— ITRIA VALLEY ——— */}
    <section aria-labelledby="area-valle">
      <div class="flex items-baseline gap-md mb-2xl border-b border-border pb-md">
        <h2 id="area-valle" class="font-display font-light text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink tracking-tight">
          Itria Valley
        </h2>
        <span class="font-body text-sm text-ink-muted">3 guides live</span>
      </div>

      <ol class="guide-grid list-none p-0 m-0">
        {valleItria.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/en/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

  </div>
</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg) var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }

  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover { transform: translateY(-2px); }
  .guide-card.is-soon { border-top-style: dashed; border-top-color: var(--color-border); cursor: default; }

  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1); }
  .guide-card:hover .guide-img { transform: scale(1.03); }

  .guide-soon-placeholder {
    width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-sm);
    background: radial-gradient(ellipse at 50% 40%, oklch(78% 0.012 75) 0%, oklch(78% 0.012 75) 28%, transparent 48%), var(--color-surface-elev);
  }
  .guide-soon-num { font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(4rem, 9vw, 6rem); line-height: 1; color: var(--color-accent); letter-spacing: -0.04em; user-select: none; opacity: 0.55; }
  .guide-soon-label { font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-ink-subtle); }

  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; pointer-events: none; }
  .guide-area { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-dur { flex-shrink: 0; color: var(--color-accent-soft); }

  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-sub { line-height: 1.5; }

  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; }
  }
</style>
