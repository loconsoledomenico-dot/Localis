---
export const prerender = true;
import Layout from '../../../components/Layout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import TrailerPlayer from '../../../components/TrailerPlayer.astro';
import PriceCard from '../../../components/PriceCard.astro';
import ChapterList from '../../../components/ChapterList.astro';
import StartMap from '../../../components/StartMap.astro';
import NarratorCard from '../../../components/NarratorCard.astro';
import StructuredData from '../../../components/StructuredData.astro';
import { getCollection, render } from 'astro:content';
import { formatDuration } from '../../../lib/format';
import { audioObjectLD, touristAttractionLD } from '../../../lib/seo';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const CITY_DEST: Record<string, { href: string; label: string }> = {
  bari: { href: '/en/bari', label: 'Bari' },
  polignano: { href: '/en/bari', label: 'Bari' },
  alberobello: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  locorotondo: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  'martina-franca': { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  cisternino: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  ostuni: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  fasano: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  vieste: { href: '/en/gargano', label: 'Gargano' },
  gargano: { href: '/en/gargano', label: 'Gargano' },
};

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.status === 'live')
    .map((guide) => ({
      params: { slug: guide.data.slug },
      props: { guide },
    }));
}

const { guide } = Astro.props;
const data = guide.data;
const { Content } = await render(guide);

const durationLabel = formatDuration(data.duration_seconds_en ?? data.duration_seconds);
const trailerSrc = data.audio_trailer_path_en ?? data.audio_trailer_path;

const ld: object[] = [
  audioObjectLD({
    slug: data.slug,
    title: data.title_en,
    description: data.seo.description_en,
    durationSeconds: data.duration_seconds_en ?? data.duration_seconds,
    language: 'en',
    priceCents: data.price_cents,
    coords: data.coords_start,
    cityName: data.city,
  }),
];

if (data.coords_start) {
  ld.push(
    touristAttractionLD(
      data.title_en,
      data.coords_start,
      data.city.charAt(0).toUpperCase() + data.city.slice(1),
    ),
  );
}
---
<Layout title={`${data.title_en} · Localis`} description={data.seo.description_en} lang="en">
  <StructuredData data={ld} />
  {(() => { const dest = CITY_DEST[data.city]; return dest ? <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: dest.label, href: dest.href }, { label: data.title_en }]} /> : <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: data.title_en }]} />; })()}
  <article class="max-w-wrap mx-auto px-md py-2xl grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-2xl items-start">
    <header class="lg:col-span-2 mb-2xl">
      <Eyebrow class="mb-md">{`Bari · ${durationLabel} · IT/EN`}</Eyebrow>
      <h1 class="font-display text-4xl text-ink leading-tight mb-sm">{data.title_en}</h1>
      <p class="font-display italic text-2xl text-ink-muted">{data.subtitle_en}</p>
    </header>

    <div class="flex flex-col gap-lg">
      <img src={data.cover} alt="" class="w-full aspect-[4/3] object-cover rounded-lg" loading="eager" />

      <TrailerPlayer src={trailerSrc} label="Preview · 60s" lang="en" />

      {data.narrator && (
        <NarratorCard
          name={data.narrator.name}
          photo={data.narrator.photo}
          bio={data.narrator.bio_en}
          lang="en"
        />
      )}

      <section>
        <h2 class="font-display text-3xl text-ink mb-md">Chapters</h2>
        <ChapterList chapters={data.chapters} lang="en" />
      </section>

      {data.coords_start && (
        <StartMap lat={data.coords_start.lat} lng={data.coords_start.lng} lang="en" />
      )}
    </div>

    <aside class="lg:sticky lg:top-24 flex flex-col gap-md">
      <PriceCard
        product="single"
        guideSlug={data.slug}
        lang="en"
        features={[
          `${data.chapters.length} chapters`,
          `${durationLabel} runtime`,
          'Italian and English',
          'Forever accessible',
          'Works offline after first play',
        ]}
      />
      <PriceCard
        product="essenziale"
        lang="en"
        features={[
          'Old Bari · San Nicola · The Best of Bari',
          '~1h 20min · 3 different voices',
          'Italian and English',
        ]}
      />
      <PriceCard
        product="bundle"
        lang="en"
        primary
        features={[
          'All 6 Bari guides',
          'Save €14.95 vs single guides',
          'Free updates when new Bari content drops',
        ]}
      />
    </aside>
  </article>
</Layout>
