---
export const prerender = true;
import Layout from '../../../components/Layout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import PriceCard from '../../../components/PriceCard.astro';
import ChapterList from '../../../components/ChapterList.astro';
import StartMap from '../../../components/StartMap.astro';
import NarratorCard from '../../../components/NarratorCard.astro';
import StructuredData from '../../../components/StructuredData.astro';
import GuideUseCase from '../../../components/GuideUseCase.astro';
import GuideFactsCard from '../../../components/GuideFactsCard.astro';
import GuideSeoEditorial from '../../../components/GuideSeoEditorial.astro';
import { getCollection } from 'astro:content';
import { formatDuration } from '../../../lib/format';
import { guideAccessibility, guideNeeds, guideRouteMode, guideStopsCount } from '../../../lib/guide-localization';
import { audioObjectLD, breadcrumbListLD, touristAttractionLD, productLD } from '../../../lib/seo';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const CITY_DEST: Record<string, { href: string; label: string }> = {
  bari: { href: '/en/bari', label: 'Bari' },
  polignano: { href: '/en/bari', label: 'Bari' },
  alberobello: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  locorotondo: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  'martina-franca': { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  cisternino: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  ostuni: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  fasano: { href: '/en/valle-d-itria', label: "Valle d'Itria" },
  vieste: { href: '/en/gargano', label: 'Gargano' },
  gargano: { href: '/en/gargano', label: 'Gargano' },
  matera: { href: '/en/matera', label: 'Matera' },
};

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.status === 'live')
    .map((guide) => ({
      params: { slug: guide.data.slug },
      props: { guide },
    }));
}

const { guide } = Astro.props;
const data = guide.data;
const destination = CITY_DEST[data.city];

const durationLabel = formatDuration(data.duration_seconds_en ?? data.duration_seconds);
const stopsCount = guideStopsCount(data);
const routeMode = guideRouteMode(data, 'en') ?? 'Self-paced walking route';
const accessibility = guideAccessibility(data, 'en') ?? 'Historic center with mixed paving. Suitable for most visitors.';
const needs = guideNeeds(data, 'en') ?? 'Headphones and a charged phone.';
const zoneBundle: 'bari-completa' | 'valle-completa' | 'gargano-completa' | null =
  data.city === 'bari' || data.city === 'polignano'
    ? 'bari-completa'
    : data.city === 'vieste' || data.city === 'gargano'
      ? 'gargano-completa'
      : data.city === 'matera'
        ? null
        : 'valle-completa';

const ld: object[] = [
  audioObjectLD({
    slug: data.slug,
    title: data.title_en,
    description: data.seo.description_en,
    durationSeconds: data.duration_seconds_en ?? data.duration_seconds,
    language: 'en',
    priceCents: data.price_cents,
    coords: data.coords_start,
    cityName: data.city,
  }),
];

if (data.coords_start) {
  ld.push(
    touristAttractionLD(
      data.title_en,
      data.coords_start,
      data.city.charAt(0).toUpperCase() + data.city.slice(1),
    ),
  );
}

ld.push(productLD({
  slug: data.slug,
  title: data.title_en,
  description: data.seo.description_en,
  cover: data.cover,
  priceCents: data.price_cents,
  language: 'en',
}));

ld.push(breadcrumbListLD([
  { name: 'Home', url: 'https://localis.guide/en/' },
  ...(destination ? [{ name: destination.label, url: `https://localis.guide${destination.href}` }] : []),
  { name: data.title_en, url: `https://localis.guide/en/guide/${data.slug}/` },
]));
---
<Layout title={`${data.title_en} · Localis`} description={data.seo.description_en} lang="en" ogImage={`/og/og-${data.slug}.jpg`}>
  <StructuredData data={ld} />
  {destination ? <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: destination.label, href: destination.href }, { label: data.title_en }]} /> : <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: data.title_en }]} />}
  <article class="max-w-wrap mx-auto px-md py-2xl grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-2xl items-start">
    <header class="order-1 lg:order-none lg:col-span-2 mb-2xl">
      <Eyebrow class="mb-md">{`Bari · ${durationLabel} · IT/EN`}</Eyebrow>
      <h1 class="font-display text-4xl text-ink leading-tight mb-sm">{data.title_en}</h1>
      <p class="font-display italic text-2xl text-ink-muted">{data.subtitle_en}</p>
    </header>

    <div class="order-3 lg:order-none flex flex-col gap-lg">
      <img src={data.cover} alt="" class="w-full aspect-[4/3] object-cover rounded-lg" loading="eager" />

      <GuideUseCase guide={data} lang="en" />
      <GuideFactsCard
        lang="en"
        distanceKm={data.distance_km}
        stopsCount={stopsCount}
        routeMode={routeMode}
        accessibility={accessibility}
        needs={needs}
      />

      {data.narrator && (
        <NarratorCard
          name={data.narrator.name}
          photo={data.narrator.photo}
          bio={data.narrator.bio_en}
          lang="en"
        />
      )}

      <section>
        <h2 class="font-display text-3xl text-ink mb-md">Chapters</h2>
        <ChapterList chapters={data.chapters} lang="en" />
      </section>

      <GuideSeoEditorial slug={data.slug} lang="en" />

      {data.coords_start && (
        <StartMap lat={data.coords_start.lat} lng={data.coords_start.lng} lang="en" />
      )}
    </div>

    <aside class="order-2 lg:order-none lg:sticky lg:top-24 flex flex-col gap-md">
      <PriceCard
        product="single"
        guideSlug={data.slug}
        lang="en"
        features={[
          `${data.chapters.length} chapters`,
          `${durationLabel} runtime`,
          'Self-guided route on your phone',
          'Italian, English and German where available',
          'Permanent link, yours forever',
          'Works offline after first play',
        ]}
      />
      <PriceCard
        product="tris"
        lang="en"
        features={[
          '3 guides of your choice',
          'Save €2.98 vs single guides',
          'Unlimited access, forever',
        ]}
      />
      {zoneBundle && (
        <PriceCard
          product={zoneBundle}
          lang="en"
          primary
          features={[
            'All 6 guides in the area',
            'Save €9.95 vs single guides',
            'Free updates when new area content drops',
          ]}
        />
      )}
    </aside>
  </article>
</Layout>
