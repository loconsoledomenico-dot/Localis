---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PriceCard from '../../components/PriceCard.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
---
<Layout
  title="Matera Audio Guide | The Sassi Explained by Localis"
  description="Explore Matera with a clear, immersive audio guide through the Sassi, the cave dwellings, the old districts and the stories behind one of Southern Italy's most unforgettable cities."
  lang="en"
>
  <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Matera' }]} />

  {/* HERO */}
  <section class="matera-hero relative overflow-hidden border-b border-border">
<img
      src="/images/covers/matera-landing.webp"
      alt="Matera, the Sassi seen from above with the Gravina ravine in the background"
      class="matera-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="matera-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="en" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md mt-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Destination — Matera
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[24ch]">
        Matera Audio Guide: understand the city carved in stone.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Matera is not a place you simply look at.<br />
        It is a city built into rock, shaped by poverty, faith, silence, abandonment and rebirth.
      </p>
<HeroAudioSample lang="en" src="/audio/trailers/matera/matera-trailer-en.mp3" guideSlug="matera" />
      <div class="mt-lg">
        <a
          href="/en/guide/matera"
          class="inline-flex items-center gap-sm px-lg py-sm font-body font-semibold text-sm text-ink border border-ink rounded-md hover:bg-ink hover:text-surface transition-colors duration-fast no-underline"
        >
          Buy the Matera audio guide
        </a>
      </div>
    </div>
  </section>

  <style>
    .matera-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .matera-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.88) contrast(1.06);
    }
    .matera-hero .text-ink,
    .matera-hero h1 {
      color: oklch(12% 0.005 240) !important;
    }
    .matera-hero .text-ink-muted,
    .matera-hero p {
      color: oklch(22% 0.008 240 / 0.9) !important;
    }
    .matera-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.85) 35%,
        oklch(from var(--color-surface) l c h / 0.45) 62%,
        oklch(from var(--color-surface) l c h / 0) 85%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .matera-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.78) 0%,
          oklch(from var(--color-surface) l c h / 0.58) 60%,
          oklch(from var(--color-surface) l c h / 0.35) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">One story · one city · millennia of stone</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* SECTION 1 — WHY THIS GUIDE */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Why this guide</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Matera can be overwhelming at first sight.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Stone houses, cave churches, stairways, terraces, ravines, empty doorways, sudden views. Everything feels ancient, but without a story it can remain only a beautiful background.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink mb-md font-medium">
          This guide helps you read Matera slowly and clearly.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">Not as a museum.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">Not as a postcard.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
          But as a living place, with a difficult past and a remarkable return to life.
        </p>
      </div>
    </div>
  </section>

  {/* SECTION 2 — WHAT YOU WILL EXPERIENCE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">What you will experience</span>
      </div>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xl max-w-[60ch]">
        This audio walk takes you through the atmosphere and meaning of Matera:
      </p>
      <ul class="list-none p-0 m-0 max-w-[60ch] flex flex-col gap-md">
        {[
          'The Sassi and their ancient structure',
          'The cave houses and the life that once filled them',
          'The difference between Sasso Caveoso and Sasso Barisano',
          'The relationship between the city and the Gravina',
          'The rock churches and the spiritual landscape of the Murgia',
          'The years of abandonment and shame',
          'The rebirth of Matera as a cultural symbol of Southern Italy',
        ].map((item) => (
          <li class="flex items-start gap-sm font-body text-base sm:text-lg text-ink-muted leading-relaxed">
            <span class="text-accent flex-shrink-0 mt-1 text-sm">✦</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* SECTION 3 — WHO IT IS FOR */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Who it is for</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          This guide is made for travellers who do not want to rush through Matera taking only photographs.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          It is for those who want to understand why the city looks the way it does, why people lived inside the rock, why the Sassi were once considered a national shame, and how Matera became one of the most fascinating places in Europe.
        </p>
        <p class="font-body text-sm text-ink-subtle leading-relaxed italic">
          Perfect for a first visit, a day trip, or a slow walk through the historic centre.
        </p>
      </div>
    </div>
  </section>

  {/* SECTION 4 — HOW IT WORKS */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-lg">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">How it works</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-xl max-w-[62ch] sm:max-w-none">
        {[
          { label: 'No group', body: 'You listen alone, or with whoever you want, at your own pace.' },
          { label: 'No fixed schedule', body: 'Start when you want. Pause. Continue. Come back.' },
          { label: 'Just your phone', body: 'No app to install. All you need is your smartphone and headphones.' },
        ].map((step) => (
          <div class="border-t border-border pt-md">
            <p class="font-display font-light text-ink text-xl mb-xs">{step.label}</p>
            <p class="font-body text-sm text-ink-muted leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SECTION 5 — LOCALIS PROMISE */}
  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="max-w-[68ch]">
        <div class="flex items-center gap-sm mb-lg">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">The Localis promise</span>
        </div>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          Localis creates audio guides for travellers who want more than quick information.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-xs">We do not simply list monuments.</p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mb-md">
          We help you understand the soul of a place: its people, its memory, its daily life, and the stories that remain hidden behind the walls.
        </p>
        <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
          With Matera, this means entering a city where stone, silence and human life have been connected for centuries.
        </p>
      </div>
    </div>
  </section>

  {/* NARRATOR — ROSA */}
  <section class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">The voice of Matera</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <div class="max-w-[38rem] mx-auto">
        <a href="/en/guide/matera" class="narr-solo-card" aria-label="Matera guide — voice of Rosa">
          <figure class="narr-solo-photo m-0">
<img
              src="/images/authors/rosa-matera-jun26.png"
              alt="Narrative portrait of Rosa"
              title="Rosa: narrative portrait built on research and Localis sources."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p class="font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0 mt-xs">
            Narrative portrait. Built on research and Localis sources.
          </p>
          <div class="mt-md">
            <p class="font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">Matera</p>
            <h3 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,1.9rem)] m-0 leading-[1.1]">Rosa</h3>
            <p class="font-body text-xs text-ink-subtle m-0">Narrative voice of the Sassi</p>
            <p class="font-body text-sm text-ink-muted m-0 mt-xs leading-relaxed">
              Grew up a few steps from the Sassi. She has watched Matera transform from a place of shame to a European capital of culture. She tells the city as someone who carries it inside, not someone explaining it from the outside.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .narr-solo-card {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      text-decoration: none;
      color: inherit;
      border-top: 1px solid var(--color-ink);
      padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-solo-card:hover { opacity: 0.82; }
    .narr-solo-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
    .narr-solo-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-solo-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    @media (prefers-reduced-motion: reduce) { .narr-solo-card { transition: none; } }
  </style>

  {/* PRICING */}
  <section id="pricing" class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Walk through Matera with meaning." />
      <p class="font-body text-sm text-ink-muted text-center max-w-[50ch] mx-auto mb-2xl">
        Start with the preview, then continue the full story.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[44rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="matera"
          lang="en"
          primary
          titleOverride="Matera Audio Guide"
          descriptionOverride="The Sassi, the Gravina, the rock churches. One complete story."
          ctaOverride="Buy the audio guide"
          features={[
            'Unlimited access, forever',
            'Italian, English and German',
            '1-click refund within 24h',
          ]}
        />
        <PriceCard
          product="tris"
          lang="en"
          features={[
            '3 guides of your choice across all zones',
            'Unlimited access, forever',
            '1-click refund within 24h',
          ]}
        />
      </div>
    </div>
  </section>

  {/* 3 STEPS */}
  <StepsBlock lang="en" ctaHref="/en/guide/matera" />

</Layout>
