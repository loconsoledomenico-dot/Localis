---
export const prerender = true;
import DestinationsBlock from '../../components/DestinationsBlock.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import Hero from '../../components/Hero.astro';
import Layout from '../../components/Layout.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
---
<Layout
  title="Localis — audio guides written in Puglia"
  description="Narrative audio guides of Puglia grounded in verifiable archival research. 18 live guides: Bari, Valle d'Itria, Gargano. From €4.99."
  lang="en"
>
  <Hero lang="en" currentPath={Astro.url.pathname} />

  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-lg grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-lg items-start">
      <div>
        <p class="text-xs font-semibold tracking-[0.24em] uppercase text-accent mb-xs">
          Self-guided audio tours
        </p>
        <p class="font-display text-2xl text-ink leading-tight m-0">
          Start from a real place, listen chapter by chapter, walk at your own pace.
        </p>
      </div>
      <p class="text-base text-ink-muted leading-relaxed m-0">
        Each guide combines a practical route, local storytelling and verifiable sources. No app to install: you get a permanent link and listen before, during or after the trip.
      </p>
    </div>
  </section>

  <StatsBlock lang="en" />

  <FeatureBlock
    eyebrow="Research · Method — Plate III"
    heading="Written in Puglia."
    italicEnding="With verifiable sources."
    body="Every chapter begins with archival research: Treccani, the DBI, academic monographs, oral memory gathered on the ground. A courtyard, a side altar, the history of the port — every claim has a public source."
    bullets={[
      'Academic sources · Treccani, DBI, Houben, Abulafia, Cioffari',
      "Published guides · Bari, Valle d'Itria, Gargano",
      'Italian, English, German · written separately, never translated',
      'Fully verifiable · every claim on /en/fonti, chapter by chapter',
    ]}
    imageSrc="/images/covers/fonti-ricerca.jpg"
    imageAlt="Research desk: Bari history books, open notebook with Old Bari notes, vintage postcards of the city, a historical map and the newspaper 'L'Eco di Bari' on San Nicola's relics"
    caption="The desk before the voice. Books, notes, postcards, clippings — every chapter starts here."
    ctaLabel="Our method"
    ctaHref="/en/method"
    imageSide="left"
    tiltDeg={-1.5}
  />

  <section class="manifesto-section bg-surface-elev border-y border-border">
    <div class="max-w-narrow mx-auto px-md py-xl lg:py-2xl">
      <p class="text-center text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle mb-md">
        — Manifesto —
      </p>

      <blockquote class="manifesto-quote font-display italic text-ink leading-[1.2] text-[clamp(1.3rem,3vw,1.9rem)] m-0 max-w-[28ch] mx-auto text-center">
        Regular audio guides tell you&nbsp;what.<br />
        Ours tell you&nbsp;why.
      </blockquote>
    </div>
  </section>

  <DestinationsBlock lang="en" />

  <section class="bg-surface" id="prezzi">
    <div class="max-w-wrap mx-auto px-md py-2xl text-center">
      <p class="font-display font-light text-[clamp(1.2rem,2.5vw,1.7rem)] text-ink mb-md">
        Want 3, 6 or all 18 guides?
      </p>
      <div class="flex flex-col items-center gap-sm">
        <a
          href="/en/guide#builder"
          class="inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
        >
          Build your package
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="text-sm text-ink-muted">Single guide €4.99 · Pack 3 Guides €11.99 · Pack 6 Guides €19.99</p>
        <p class="text-xs text-ink-subtle max-w-[42ch] text-center">Complete Area appears only when you choose all 6 guides from the same area.</p>
      </div>
    </div>
  </section>

  <FeatureBlock
    eyebrow="Tool — Plate V"
    heading="Opens with a link."
    italicEnding="Listen anywhere. No app."
    body="You pay with email and card. You receive a permanent link: open it whenever you want, press play, listen. On the street while you walk, on the couch before you leave, on the train coming back. These are stories, not museum audio describing what's in front of you — they take you inside Bari, even if you're not there yet."
    bullets={[
      'Free listening · on-site, before, after, anywhere',
      'Magic link via email · zero passwords, zero accounts',
      'Permanent link · the guide is yours, replay forever',
    ]}
    imageSrc="/images/covers/nave-crociera.jpg"
    imageAlt="Group of cruise passengers disembarking in Bari in front of the MSC Splendida; port lungomare in the background, full sunlight"
    caption="Bari, cruise port. For them the audio guide starts as soon as they hit the dock."
    ctaLabel="See the guides"
    ctaHref="#guide"
    imageSide="right"
    tiltDeg={1.5}
    mobileAspect="3 / 2"
    framedImage
  />

  <StepsBlock lang="en" ctaHref="/en/guide/bari-vecchia" />
</Layout>

<style>
  .manifesto-quote {
    opacity: 0;
    transform: translateY(10px);
    animation: manifestoIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }
  @keyframes manifestoIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-quote {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
