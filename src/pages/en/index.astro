---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import Hero from '../../components/Hero.astro';
import GuideCard from '../../components/GuideCard.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((g) => g.data.city === 'bari')
  .sort((a, b) => a.data.published_at.getTime() - b.data.published_at.getTime());
---
<Layout
  title="Localis — narrative audio guides for Puglia"
  description="Narrative audio guides of Bari that make you understand, not list. Four live guides, written by locals. €4.99."
  lang="en"
>
  <Hero lang="en" />

  <section id="guide" class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
    <SectionDivider label="Choose your experience" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg">
      {guides.map((g, i) => (
        <GuideCard guide={g} lang="en" index={i} />
      ))}
    </div>
  </section>

  <section class="max-w-narrow mx-auto px-md py-3xl lg:py-4xl text-center">
    <p class="font-display italic text-3xl text-ink mb-md leading-tight">Regular audio guides tell you what.<br />Ours tell you why.</p>
    <p class="text-base text-ink-muted leading-relaxed max-w-prose mx-auto">
      Real stories, built on the real places of the city. While you listen, you are exactly where it all happened.
    </p>
  </section>

  <section id="prezzi" class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
    <SectionDivider label="Choose your plan" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[56rem] mx-auto">
      <PriceCard
        product="single"
        guideSlug="bari-vecchia"
        lang="en"
        features={[
          '1 guide of your choice',
          'Unlimited access, forever',
          'Italian and English',
          '1-click refund within 24h',
        ]}
      />
      <PriceCard
        product="bundle"
        lang="en"
        primary
        features={[
          'Old Bari — Inside the City',
          'Port of Bari — Where It All Happened',
          'San Nicola — The Stolen Saint',
          '1-click refund within 24h',
        ]}
      />
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-md py-3xl text-center">
    <p class="font-display italic text-2xl text-ink-muted mb-xs">If you want to visit Bari, you can.</p>
    <p class="font-display text-3xl text-ink mb-lg">If you want to understand it, listen.</p>
    <a href="#guide" class="inline-flex items-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-colors duration-fast no-underline">
      Start the journey →
    </a>
  </section>

  <MobileStickyCTA lang="en" />
</Layout>
