---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';

const articles = (
  await getCollection('blog', (e) => e.data.lang === 'en' && e.data.status === 'published')
).sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime());

const langUrlsOverride = { it: '/blog/', en: '/en/blog/', de: '/de/blog/' };
---

<Layout
  title="Blog — Puglia Guides & History · Localis"
  description="Free articles on the history and culture of Puglia: Bari, Valle d'Itria, Gargano. Archive-based research, written for curious travelers."
  lang="en"
  langUrlsOverride={langUrlsOverride}
>
  <div class="max-w-wrap mx-auto px-md py-2xl">
    <header class="max-w-narrow mx-auto mb-2xl">
      <p class="text-xs font-semibold tracking-[0.20em] uppercase text-accent mb-sm">Free reading</p>
      <h1 class="font-display text-4xl text-ink leading-tight mb-md">Blog</h1>
      <p class="text-lg text-ink-muted">
        History and culture articles about Puglia — written for travelers who want to understand before they visit.
      </p>
    </header>

    {articles.length === 0 ? (
      <p class="text-ink-muted max-w-narrow mx-auto">Coming soon.</p>
    ) : (
      <ul class="max-w-narrow mx-auto grid gap-lg" role="list">
        {articles.map((article) => (
          <li>
            <a href={`/en/blog/${article.data.slug}/`} class="group grid sm:grid-cols-[200px_1fr] gap-md rounded-lg border border-border hover:border-accent/40 hover:bg-surface-elev transition-colors no-underline overflow-hidden">
              <img src={article.data.cover} alt={article.data.cover_alt} width={article.data.cover_width} height={article.data.cover_height} loading="lazy" decoding="async" class="w-full h-32 sm:h-full object-cover" />
              <div class="flex flex-col gap-xs p-md sm:pl-0">
                <span class="text-xs font-semibold tracking-[0.16em] uppercase text-accent">{article.data.zone_label}</span>
                <span class="font-display text-xl text-ink leading-snug group-hover:text-accent/90 transition-colors">{article.data.title}</span>
                <span class="text-sm text-ink-muted line-clamp-2">{article.data.description}</span>
                <time datetime={article.data.published_at.toISOString().split('T')[0]} class="text-xs text-ink-subtle mt-auto">
                  {article.data.published_at.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
