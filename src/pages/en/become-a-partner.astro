---
export const prerender = true;
import Layout from '../../components/Layout.astro';
---
<Layout title="Become a partner · Localis" lang="en">
  <main class="max-w-narrow mx-auto px-md py-3xl text-center">
    <p class="font-display italic text-2xl text-ink-muted mb-md">Not available in English yet.</p>
    <h1 class="font-display text-4xl text-ink mb-lg">Partner programme</h1>
    <p class="text-base text-ink-muted mb-xl max-w-prose mx-auto">
      This page is currently available in Italian only. If you are interested in becoming a Localis partner, please get in touch via the Italian page.
    </p>
    <div class="flex flex-wrap justify-center gap-sm">
      <a href="/diventa-partner" class="inline-flex px-md py-sm bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-colors duration-fast no-underline">
        Vai alla pagina in italiano
      </a>
      <a href="/en" class="inline-flex px-md py-sm border border-border text-ink rounded-md font-semibold text-sm hover:border-ink transition-colors duration-fast no-underline">
        Back to homepage
      </a>
    </div>
  </main>
</Layout>
