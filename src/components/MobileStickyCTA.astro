---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
  /** Override CTA destination. Defaults to the primary teaser guide. */
  href?: string;
  /** Override CTA label. */
  label?: string;
  /** Price shown alongside the label. */
  price?: string;
  /** CSS selector for a conversion zone that should hide this CTA when in view (default: #prezzi). */
  hideAtSelector?: string;
}

const {
  lang,
  href,
  label,
  price = lang === 'it' ? '€4,99' : lang === 'de' ? '4,99 €' : '€4.99',
  hideAtSelector = '#prezzi',
} = Astro.props;

const finalHref = href ?? (lang === 'it' ? '/guide/bari-vecchia' : lang === 'de' ? '/de/guide/bari-vecchia' : '/en/guide/bari-vecchia');
const finalLabel = label ?? (lang === 'it' ? 'Ascolta un assaggio' : lang === 'de' ? 'Hörprobe öffnen' : 'Listen to a teaser');
const ariaLabel = `${finalLabel} · ${price}`;
---
<a
  href={finalHref}
  class="mobile-cta"
  data-mobile-cta
  data-hide-selector={hideAtSelector}
  aria-label={ariaLabel}
>
  <span class="mobile-cta-price font-display italic">{price}</span>
  <span class="mobile-cta-divider" aria-hidden="true">·</span>
  <span class="mobile-cta-label">{finalLabel}</span>
  <svg
    class="mobile-cta-arrow"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
</a>

<style>
  .mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-md) var(--spacing-md);
    padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom, 0px));
    background: var(--color-ink);
    color: var(--color-surface);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 -2px 16px -4px oklch(15% 0.012 240 / 0.18);
    transform: translateY(110%);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 0.3s;
  }

  .mobile-cta.is-visible {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 0s;
  }

  .mobile-cta:active {
    transform: translateY(1px);
  }

  .mobile-cta-price {
    font-size: 1.1rem;
    font-weight: 300;
  }

  .mobile-cta-divider {
    opacity: 0.5;
    margin-inline: 2px;
  }

  .mobile-cta-arrow {
    margin-left: var(--spacing-xs);
  }

  /* Desktop and up: hide entirely */
  @media (min-width: 768px) {
    .mobile-cta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-cta {
      transition: opacity 0.15s linear, visibility 0s linear;
      transform: none;
    }
    .mobile-cta.is-visible {
      transform: none;
    }
  }
</style>

<script>
  type WithPlausible = Window & {
    plausible?: (event: string, options?: { props?: Record<string, string | number> }) => void;
  };

  (() => {
    const cta = document.querySelector<HTMLAnchorElement>('[data-mobile-cta]');
    if (!cta) return;

    const hero = document.querySelector<HTMLElement>('.hero');
    const hideSelector = cta.dataset.hideSelector || '#prezzi';
    const hideZone = document.querySelector<HTMLElement>(hideSelector);

    let heroVisible = true;
    let conversionVisible = false;

    const updateVisibility = () => {
      const shouldShow = !heroVisible && !conversionVisible;
      cta.classList.toggle('is-visible', shouldShow);
    };

    if (hero) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            heroVisible = entry.intersectionRatio > 0.15;
          }
          updateVisibility();
        },
        { threshold: [0, 0.15, 0.5, 1] }
      );
      heroObserver.observe(hero);
    } else {
      heroVisible = false;
    }

    if (hideZone) {
      const zoneObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            conversionVisible = entry.isIntersecting;
          }
          updateVisibility();
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );
      zoneObserver.observe(hideZone);
    }

    cta.addEventListener('click', () => {
      const win = window as WithPlausible;
      if (typeof win.plausible === 'function') {
        win.plausible('Mobile Sticky CTA Click');
      }
    });
  })();
</script>
