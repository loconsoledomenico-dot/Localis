---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
  ctaHref?: string;
}

const { lang, ctaHref = '#guide' } = Astro.props;

const eyebrow = lang === 'it' ? 'In tre minuti, sei dentro' : 'Three minutes in, you\'re there';
const heading = lang === 'it' ? 'Tre passi.' : 'Three steps.';
const headingItalic = lang === 'it' ? 'Una terra che parla, quando vuoi tu.' : 'A land that speaks, whenever you want.';

const steps = lang === 'it'
  ? [
      { n: '1', title: 'Scegli la destinazione', body: 'Bari, Valle d\'Itria, Gargano — ogni zona ha la sua guida.' },
      { n: '2', title: 'Apri il link', body: 'Niente app. Compri, ti arriva un link, premi play.' },
      { n: '3', title: 'Ascolta', body: 'Le storie partono. In strada, sul divano, in treno — ovunque.' },
    ]
  : [
      { n: '1', title: 'Choose a destination', body: 'Bari, Valle d\'Itria, Gargano — every zone has its own guide.' },
      { n: '2', title: 'Open the link', body: 'No app. Buy, get a link, press play.' },
      { n: '3', title: 'Listen', body: 'The stories begin. On the street, on the couch, on the train — anywhere.' },
    ];

const ctaLabel = lang === 'it' ? 'Inizia ora · gratis i primi 60 secondi' : 'Start now · first 60 seconds free';
---
<section class="steps bg-surface">
  <div class="max-w-steps mx-auto px-md sm:px-lg py-2xl lg:py-3xl text-center">

    <div class="inline-flex items-center gap-sm mb-md">
      <span class="block w-7 h-px bg-accent"></span>
      <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
        {eyebrow}
      </span>
      <span class="block w-7 h-px bg-accent"></span>
    </div>

    <h2 class="font-display text-ink leading-[1.1] tracking-[-0.014em] mb-xl text-[clamp(1.6rem,3.2vw,2.2rem)]">
      <span class="block font-light">{heading}</span>
      <span class="block font-body font-normal text-ink-muted mt-2xs text-[clamp(1rem,1.8vw,1.25rem)] leading-relaxed tracking-normal">{headingItalic}</span>
    </h2>

    <ol class="steps-list grid grid-cols-1 sm:grid-cols-3 gap-lg sm:gap-xl list-none p-0 m-0 mb-xl">
      {steps.map((s, i) => (
        <li class="step-cell flex flex-col items-center" style={`--idx:${i}`}>
          <span class="step-num font-display italic font-light text-accent text-[clamp(2.4rem,5vw,3.4rem)] leading-none mb-2xs select-none">
            {s.n}
          </span>
          <span class="font-display text-ink text-lg sm:text-xl leading-tight mb-2xs">
            {s.title}
          </span>
          <span class="font-body text-sm text-ink-muted leading-snug max-w-[24ch]">
            {s.body}
          </span>
        </li>
      ))}
    </ol>

    <a
      href={ctaHref}
      class="inline-flex items-center justify-center gap-xs px-xl py-md rounded-md font-semibold text-sm bg-ink text-surface hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
      {ctaLabel}
    </a>
  </div>
</section>

<style>
  .step-cell {
    opacity: 0;
    transform: translateY(12px);
    animation: stepIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 120ms + 100ms);
  }

  @keyframes stepIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
