---
import { allLangUrls, type Lang, withLangQuery } from '../lib/i18n';

export interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const urls = allLangUrls(currentPath);
---
<div class="lang-flags" role="navigation" aria-label="Language">

  {/* 🇮🇹 Italy */}
  {lang === 'it' ? (
    <span class="lang-flag lang-flag--active" aria-current="true" title="Italiano">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 3 2" width="22" height="15" aria-hidden="true">
        <rect width="1" height="2" fill="#009246"/>
        <rect x="1" width="1" height="2" fill="#fff"/>
        <rect x="2" width="1" height="2" fill="#ce2b37"/>
      </svg>
    </span>
  ) : (
    <a href={withLangQuery(urls.it, 'it')} class="lang-flag" hreflang="it" title="Italiano" aria-label="Italiano">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 3 2" width="22" height="15" aria-hidden="true">
        <rect width="1" height="2" fill="#009246"/>
        <rect x="1" width="1" height="2" fill="#fff"/>
        <rect x="2" width="1" height="2" fill="#ce2b37"/>
      </svg>
    </a>
  )}

  {/* 🇬🇧 UK */}
  {lang === 'en' ? (
    <span class="lang-flag lang-flag--active" aria-current="true" title="English">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" width="22" height="15" aria-hidden="true">
        <rect width="60" height="30" fill="#012169"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
        <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
        <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
      </svg>
    </span>
  ) : (
    <a href={withLangQuery(urls.en, 'en')} class="lang-flag" hreflang="en" title="English" aria-label="English">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" width="22" height="15" aria-hidden="true">
        <rect width="60" height="30" fill="#012169"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
        <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
        <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
      </svg>
    </a>
  )}

  {/* 🇩🇪 Germany */}
  {lang === 'de' ? (
    <span class="lang-flag lang-flag--active" aria-current="true" title="Deutsch">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5 3" width="22" height="15" aria-hidden="true">
        <rect width="5" height="1" fill="#000"/>
        <rect y="1" width="5" height="1" fill="#D00"/>
        <rect y="2" width="5" height="1" fill="#FFCE00"/>
      </svg>
    </span>
  ) : (
    <a href={withLangQuery(urls.de, 'de')} class="lang-flag" hreflang="de" title="Deutsch" aria-label="Deutsch">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5 3" width="22" height="15" aria-hidden="true">
        <rect width="5" height="1" fill="#000"/>
        <rect y="1" width="5" height="1" fill="#D00"/>
        <rect y="2" width="5" height="1" fill="#FFCE00"/>
      </svg>
    </a>
  )}

</div>

<style>
  .lang-flags {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang-flag {
    display: flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.35;
    transition: opacity 0.15s;
    border-radius: 2px;
    overflow: hidden;
    line-height: 0;
  }
  .lang-flag:hover {
    opacity: 1;
  }
  .lang-flag--active {
    opacity: 1;
    cursor: default;
    box-shadow: 0 0 0 1.5px oklch(from var(--color-accent) l c h / 0.6);
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-flag { transition: none; }
  }
</style>
