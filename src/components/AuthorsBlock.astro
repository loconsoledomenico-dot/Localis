---
import { type Lang } from '../lib/i18n';

export interface Author {
  /** Titolo della guida che racconta (es. "Bari Vecchia", "Il Meglio di Bari") */
  guideTitle: string;
  /** Numero ordinale Tav. VI · 01-06 */
  ordinal: string;
  /** Nome reale del narratore. Se vuoto: render placeholder. */
  name?: string;
  /** Bio breve (2-3 righe). Se vuoto: render placeholder. */
  bioIt?: string;
  bioEn?: string;
  /** Iniziali per il fallback (es. "F.M."). Auto-derivate se manca. */
  initials?: string;
  /** Path foto B/W 3:4. Se vuoto: render silhouette tipografica. */
  photo?: string;
  /** True quando la voce è un personaggio editoriale composito. */
  composite?: boolean;
  /** Se true, mostra badge "Profilo in arrivo" sopra la card */
  draft?: boolean;
}

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Tavola VI - Gli autori' : lang === 'de' ? 'Tafel VI - Die Autoren' : 'Plate VI - The authors';
const heading1 = lang === 'it' ? 'Sei autori baresi.' : lang === 'de' ? 'Sechs Autoren aus Bari.' : 'Six authors from Bari.';
const heading2 = lang === 'it' ? 'Sei voci, sei guide, una sola Bari.' : lang === 'de' ? 'Sechs Stimmen, sechs Guides, ein Bari.' : 'Six voices, six guides, one Bari.';
const intro = lang === 'it'
  ? 'Non guide certificate, non copia-incolla Wikipedia. Autori che quei vicoli li hanno vissuti, hanno mangiato in quei panifici, hanno visto cambiare quei mercati. Ogni guida e firmata: nome, volto, storia.'
  : lang === 'de'
    ? 'Keine lizenzierten Stadtfuehrer, kein Wikipedia-Copy-and-paste. Stimmen, die aus gelebter Erfahrung, Recherche und redaktioneller Arbeit entstehen. Jeder Guide hat eine Stimme: Name, Gesicht, Geschichte.'
    : 'Not licensed guides, not Wikipedia copy-paste. Authors who lived those alleys, ate in those bakeries, watched those markets change. Each guide is signed: name, face, story.';
const draftBadge = lang === 'it' ? 'Profilo in arrivo' : lang === 'de' ? 'Profil folgt' : 'Profile coming';
const photoSoonLabel = lang === 'it' ? 'Ritratto in arrivo' : lang === 'de' ? 'Portraet folgt' : 'Portrait coming';

// Placeholders editoriali — nessun nome inventato di persona reale.
// Quando il narratore reale è confermato, sostituire `name`, `bioIt`, `bioEn`,
// `photo` (path /images/authors/<slug>.jpg) e rimuovere `draft: true`.
const authors: Author[] = [
  {
    guideTitle: 'Bari Vecchia',
    ordinal: '01',
    name: 'Domenico Loconsole',
    initials: 'D.L.',
    photo: '/images/authors/domenico-loconsole.png',
    bioIt: 'Cinquantotto anni. Bari Vecchia è la sua seconda casa: a nove anni, nei vicoli, giocava a iù mont della lun e a sguincio con i tappi di rame della birra. Le pietre lo riconoscono.',
    bioEn: 'Fifty-eight. Old Bari is his second home: at nine, in those alleys, he played iù mont della lun and sguincio — flicking copper beer-bottle caps off the limestone. The stones still know his step.',
  },
  {
    guideTitle: 'Tre Teatri',
    ordinal: '02',
    name: 'Filippo Bellomo',
    initials: 'F.B.',
    photo: '/images/authors/filippo-headshot.jpg',
    bioIt: 'Quarant\'anni alla Camera di Commercio di Bari, dove lo conoscevano tutti. Padre di due figli, nonno di quattro nipoti. Murat per lui non è solo un quartiere — sono quarant\'anni di colleghi, caffè al banco, riunioni finite in pizzeria.',
    bioEn: 'Forty years at the Bari Chamber of Commerce, where everyone knew his name. Father of two, grandfather of four. Murat isn\'t just a neighbourhood for him — it\'s forty years of colleagues, counter-bar coffees, meetings that ended in pizzerias.',
  },
  {
    guideTitle: 'San Nicola',
    ordinal: '03',
    name: 'Nonno Nicola',
    initials: 'N.N.',
    photo: '/images/authors/nonno-nicola.jpg',
    bioIt: 'Ottantatré anni, cresciuto a Libertà nel dopoguerra — quartiere operaio, mercato, biciclette appoggiate ai muri. San Nicola è il santo che vedeva passare in processione da bambino, prima ancora di sapere cosa volesse dire "protettore".',
    bioEn: 'Eighty-three years old, raised in Libertà in the post-war years — working-class quarter, market, bicycles leaning on walls. San Nicola is the saint he saw in procession as a child, before he even knew what "protector" meant.',
  },
  {
    guideTitle: 'Il Meglio di Bari',
    ordinal: '04',
    name: 'Rachele Grande',
    initials: 'R.G.',
    photo: '/images/authors/rachele-grande.jpg',
    bioIt: 'Barese, scherzosa, mai a tavola da sola. La voce dietro la guida sul cibo: focaccia, polpo, orecchiette, caffè. Ti porta dove mangia chi ci vive — non dove dice TripAdvisor.',
    bioEn: 'From Bari, playful, never eats alone. The voice behind the food guide: focaccia, octopus, orecchiette, coffee. She takes you where locals actually eat — not where TripAdvisor sends you.',
  },
  {
    guideTitle: 'Porto di Bari',
    ordinal: '05',
    name: 'Luigi Loconsole',
    initials: 'L.L.',
    photo: '/images/authors/luigi-loconsole.jpg',
    bioIt: 'Cinquantaquattro anni. Troppi passati in mare per contarli. Conosce il Porto dentro, fuori, sopra e sotto — e le feste che il lungomare ricorda meno di lui.',
    bioEn: 'Fifty-four. Too many years on the water to count. He knows the Port inside, outside, above and below — and the festivals the lungomare remembers worse than he does.',
  },
  {
    guideTitle: 'Bari Sotterranea',
    ordinal: '06',
    name: 'Rosa "la Perpetua"',
    initials: 'R.P.',
    photo: '/images/authors/rosa-perpetua.jpg',
    composite: true,
    bioIt: 'Cinquant\'anni di servizio nella Basilica di San Nicola — a pulire, riordinare, ascoltare. Adesso in pensione, ma le pietre della cripta sa ancora ricordarle a memoria. Una pulita per volta.',
    bioEn: 'Fifty years of service in the Basilica of San Nicola — cleaning, tidying, listening. Now retired, but she can still recall every stone of the crypt by heart. One wipe at a time.',
  },
];

function deriveInitials(a: Author): string {
  if (a.initials) return a.initials;
  if (a.name) {
    return a.name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((s) => s[0]?.toUpperCase() ?? '')
      .join('.') + '.';
  }
  return a.guideTitle.split(/\s+/).slice(0, 2).map((s) => s[0]?.toUpperCase() ?? '').join('');
}

function bioFor(a: Author): string {
  const draftIt = `Voce confermata per "${a.guideTitle}". Foto e bio breve a giorni.`;
  const draftEn = `Voice confirmed for "${a.guideTitle}". Photo and short bio coming soon.`;
  const draftDe = `Stimme fuer "${a.guideTitle}" bestaetigt. Foto und Kurzbiografie folgen bald.`;
  if (lang === 'it') {
    return a.bioIt ?? draftIt;
  }
  if (lang === 'de') {
    return a.bioEn ?? draftDe;
  }
  return a.bioEn ?? draftEn;
}

function photoNoteFor(a: Author): string {
  if (a.composite) {
    return lang === 'it'
      ? 'Voce editoriale composita. Ritratto evocativo.'
      : lang === 'de'
        ? 'Zusammengesetzte redaktionelle Stimme. Sinnbildliches Portraet.'
        : 'Composite editorial voice. Evocative portrait.';
  }
  return lang === 'it'
    ? 'Persona reale. Ritratto dell\'autore.'
    : lang === 'de'
      ? 'Reale Person. Autorenportraet.'
      : 'Real person. Author portrait.';
}

function photoTitleFor(a: Author): string {
  if (a.composite) {
    return lang === 'it'
      ? `${a.name}: personaggio editoriale composito costruito da ricerca, fonti e raccolta sul campo. Ritratto evocativo.`
      : lang === 'de'
        ? `${a.name}: zusammengesetzte redaktionelle Figur aus Recherche, Quellen und Material vor Ort. Sinnbildliches Portraet.`
        : `${a.name}: composite editorial character built from research, sources and field material. Evocative portrait.`;
  }
  return lang === 'it'
    ? `${a.name}: persona reale e autore della guida ${a.guideTitle}.`
    : lang === 'de'
      ? `${a.name}: reale Person und Autor des Guides ${a.guideTitle}.`
      : `${a.name}: real person and author of the ${a.guideTitle} guide.`;
}
---
<section class="authors bg-surface">
  <div class="max-w-wrap mx-auto px-md sm:px-lg py-3xl lg:py-4xl">

    <!-- Section header -->
    <div class="authors-header max-w-[60ch] mb-2xl lg:mb-3xl">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          {eyebrow}
        </span>
      </div>
      <h2 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(1.9rem,4.4vw,3rem)]">
        <span class="font-light">{heading1}</span>
        <span class="block font-body font-normal text-ink-muted mt-sm text-[clamp(1.15rem,2.4vw,1.55rem)] leading-relaxed tracking-normal">
          {heading2}
        </span>
      </h2>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
        {intro}
      </p>
    </div>

    <!-- Plates grid: 1 col mobile, 2 cols sm, 3 cols lg -->
    <ol class="authors-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-xl gap-y-2xl list-none p-0 m-0">
      {authors.map((a, i) => {
        const initials = deriveInitials(a);
        const bio = bioFor(a);
        const photoNote = photoNoteFor(a);
        const photoTitle = photoTitleFor(a);
        const isPlaceholderName = !a.name;

        return (
          <li class="author-cell" style={`--idx:${i}`}>
            <article class="author-plate">
              <!-- Photo / silhouette -->
              <figure class="author-photo m-0">
                {a.photo ? (
                  <img
                    src={a.photo}
                    alt={a.name ? `Ritratto di ${a.name}, narratore di "${a.guideTitle}"` : `Ritratto in arrivo per "${a.guideTitle}"`}
                    title={photoTitle}
                    class="author-img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="author-silhouette" role="img" aria-label={`${photoSoonLabel} — ${a.guideTitle}`}>
                    <span class="silhouette-initials">{initials}</span>
                    <span class="silhouette-label">{photoSoonLabel}</span>
                  </div>
                )}
                {a.draft && (
                  <span class="author-draft" aria-hidden="true">{draftBadge}</span>
                )}
              </figure>
              {a.photo && (
                <p class="author-photo-note font-body text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-subtle m-0">
                  {photoNote}
                </p>
              )}

              <!-- Meta -->
              <div class="author-meta">
                <span class="author-ordinal font-body font-semibold text-[10px] tracking-[0.32em] uppercase text-ink-subtle">
                  Tav. VI · {a.ordinal} {' / '} 06
                </span>
                <h3 class="author-name font-display text-ink leading-[1.1] m-0">
                  {isPlaceholderName ? (
                    <span class="text-ink-subtle italic font-light">
                      {lang === 'it' ? 'Autore di' : lang === 'de' ? 'Autor von' : 'Author of'} <span class="not-italic font-normal text-ink">{a.guideTitle}</span>
                    </span>
                  ) : (
                    <>
                      <span class="font-light">{a.name}</span>
                      <span class="block font-body font-normal text-ink-muted text-[0.62em] mt-2xs tracking-normal">
                        {a.guideTitle}
                      </span>
                    </>
                  )}
                </h3>
                <p class="author-bio font-body text-sm text-ink-muted leading-snug max-w-[36ch] mb-0">
                  {bio}
                </p>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .author-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: authorIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 90ms + 100ms);
  }

  .author-plate {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    border-top: 1px solid var(--color-ink);
    padding-top: var(--spacing-md);
  }

  /* Photo plate */
  .author-photo {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08),
                0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }

  .author-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Editorial B/W treatment */
    filter: grayscale(100%) contrast(1.06) brightness(0.96);
  }

  .author-photo-note {
    margin-top: calc(var(--spacing-md) * -0.55);
    line-height: 1.35;
  }

  /* Silhouette placeholder — initials in Spectral italic on parchment */
  .author-silhouette {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    background:
      radial-gradient(ellipse at 50% 32%, oklch(75% 0.012 75) 0%, oklch(75% 0.012 75) 22%, transparent 40%),
      var(--color-surface-elev);
  }

  .silhouette-initials {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .silhouette-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  /* Draft badge */
  .author-draft {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-surface);
    background: var(--color-accent);
    padding: 4px 10px;
    line-height: 1.4;
  }

  /* Meta */
  .author-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .author-ordinal {
    color: var(--color-ink-subtle);
  }

  .author-name {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 300;
  }

  .author-bio {
    color: var(--color-ink-muted);
  }

  @keyframes authorIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .author-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
