---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Tavola IV — I luoghi' : lang === 'de' ? 'Tafel IV — Die Orte' : 'Plate IV — The places';
const heading1 = lang === 'it' ? 'Sei racconti per capire Bari.' : lang === 'de' ? 'Sechs Erzählungen, um Bari zu verstehen.' : 'Six stories to understand Bari.';
const heading2 = lang === 'it' ? 'Sei luoghi, una sola città da capire.' : lang === 'de' ? 'Sechs Orte, eine Stadt zum Entdecken.' : 'Six places, one city to discover.';
const intro = lang === 'it'
  ? 'Sei racconti audio per entrare nella storia viva della città: il borgo antico, San Nicola, il cibo, il porto, i teatri e ciò che resta sotto le strade.'
  : lang === 'de'
  ? 'Sechs Audioerzählungen, um in die lebendige Geschichte der Stadt einzutauchen: die Altstadt, San Nicola, das Essen, der Hafen, die Theater und was unter den Strassen liegt.'
  : 'Six audio stories to enter the living history of the city: the old town, San Nicola, food, the port, the theatres and what remains beneath the streets.';

interface Place {
  slug: string;
  title: string;
  duration: string;
  quartiere: string;
  startsAt: string;
  cover: string;
  alt: string;
  objectPosition?: string;
  /** Prezzo singolo della guida (es. "€4,99") — vuoto sul placeholder */
  price?: string;
  draft?: boolean;
}

const places: Place[] = lang === 'it'
  ? [
      {
        slug: 'bari-vecchia',
        title: 'Bari Vecchia — Dentro la Città',
        duration: '32 min',
        quartiere: 'Borgo Antico',
        startsAt: 'Strada delle Crociate',
        cover: '/images/covers/bari-vecchia-passeggiata.jpg',
        alt: 'Vicolo del Borgo Antico di Bari con colonne romane antiche e palazzi storici',
        price: '€4,99',
      },
      {
        slug: 'san-nicola',
        title: 'San Nicola — Il Santo Rubato',
        duration: '30 min',
        quartiere: 'Borgo Antico',
        startsAt: 'Basilica di San Nicola',
        cover: '/images/covers/san-nicola-basilica.webp',
        alt: 'Facciata della Basilica di San Nicola a Bari',
        objectPosition: '72% center',
        price: '€4,99',
      },
      {
        slug: 'bari-tavola',
        title: 'Bari a tavola — Cibo, mare e vicoli',
        duration: '28 min',
        quartiere: 'Borgo Antico',
        startsAt: 'Strada Arco Basso',
        cover: '/images/covers/bari-tavola-cover.webp',
        objectPosition: 'top',
        alt: 'Polpo fresco servito a Bari, simbolo del rapporto tra la città, il mare e la tavola',
        price: '€4,99',
      },
      {
        slug: 'porto-bari',
        title: 'Porto di Bari — Dove è Successo Tutto',
        duration: '33 min',
        quartiere: 'Lungomare',
        startsAt: 'Molo San Nicola',
        cover: '/images/covers/porto-bari-card.jpg',
        alt: 'Porto storico di Bari con velieri ormeggiati e banchina sul mare',
        price: '€4,99',
      },
      {
        slug: 'tre-teatri',
        title: 'I Tre Teatri — Fuoco, Musica e Borghesia',
        duration: '28 min',
        quartiere: 'Murat',
        startsAt: 'Teatro Piccinni',
        cover: '/images/covers/tre-teatri-card.webp',
        alt: 'Teatro Petruzzelli, Teatro Piccinni e Teatro Margherita di Bari',
        price: '€4,99',
      },
      {
        slug: 'bari-sotterranea',
        title: 'Bari Sotterranea — Quello che sta sotto',
        duration: '26 min',
        quartiere: 'Borgo Antico',
        startsAt: 'Basilica di San Nicola',
        cover: '/images/covers/bari-sotterranea-card.jpg',
        alt: 'Ingresso sotterraneo tra i vicoli di Bari Vecchia con scala in pietra illuminata',
        price: '€4,99',
      },
    ]
  : lang === 'de'
  ? [
      {
        slug: 'bari-vecchia',
        title: 'Bari Vecchia — In der Altstadt',
        duration: '33 min',
        quartiere: 'Altstadt',
        startsAt: 'Strada delle Crociate',
        cover: '/images/covers/bari-vecchia-passeggiata.jpg',
        alt: 'Gasse in der Altstadt von Bari mit antiken römischen Säulen und historischen Häusern',
        price: '4,99 €',
      },
      {
        slug: 'san-nicola',
        title: 'San Nicola — Der geraubte Heilige',
        duration: '30 min',
        quartiere: 'Altstadt',
        startsAt: 'Basilika San Nicola',
        cover: '/images/covers/san-nicola-basilica.webp',
        alt: 'Fassade der Basilika San Nicola in Bari',
        objectPosition: '72% center',
        price: '4,99 €',
      },
      {
        slug: 'bari-tavola',
        title: 'Bari bei Tisch — Essen, Meer und Gassen',
        duration: '28 min',
        quartiere: 'Altstadt',
        startsAt: 'Strada Arco Basso',
        cover: '/images/covers/bari-tavola-cover.webp',
        objectPosition: 'top',
        alt: 'Frischer Polpo in Bari, Symbol der Verbindung zwischen Stadt, Meer und Tisch',
        price: '4,99 €',
      },
      {
        slug: 'porto-bari',
        title: 'Hafen von Bari — Wo alles begann',
        duration: '33 min',
        quartiere: 'Uferpromenade',
        startsAt: 'Molo San Nicola',
        cover: '/images/covers/porto-bari-card.jpg',
        alt: 'Historischer Hafen von Bari mit Segelschiffen an der Mole',
        price: '4,99 €',
      },
      {
        slug: 'tre-teatri',
        title: 'Die drei Theater — Feuer, Musik und Bürgertum',
        duration: '28 min',
        quartiere: 'Murat',
        startsAt: 'Teatro Piccinni',
        cover: '/images/covers/tre-teatri-card.webp',
        alt: 'Teatro Petruzzelli, Teatro Piccinni und Teatro Margherita in Bari',
        price: '4,99 €',
      },
      {
        slug: 'bari-sotterranea',
        title: 'Bari unter der Erde — Was darunter liegt',
        duration: '26 min',
        quartiere: 'Altstadt',
        startsAt: 'Basilika San Nicola',
        cover: '/images/covers/bari-sotterranea-card.jpg',
        alt: 'Unterirdischer Eingang in den Gassen von Bari Vecchia mit beleuchteter Steintreppe',
        price: '4,99 €',
      },
    ]
  : [
      {
        slug: 'bari-vecchia',
        title: 'Old Bari — Inside the City',
        duration: '31 min',
        quartiere: 'Old town',
        startsAt: 'Strada delle Crociate',
        cover: '/images/covers/bari-vecchia-passeggiata.jpg',
        alt: 'Old Bari alley with ancient Roman columns and historic buildings',
        price: '€4.99',
      },
      {
        slug: 'san-nicola',
        title: 'San Nicola — The Stolen Saint',
        duration: '30 min',
        quartiere: 'Old town',
        startsAt: 'Basilica di San Nicola',
        cover: '/images/covers/san-nicola-basilica.webp',
        alt: 'Façade of the Basilica of San Nicola in Bari',
        objectPosition: '72% center',
        price: '€4.99',
      },
      {
        slug: 'bari-tavola',
        title: 'Bari at the table — Food, sea and alleyways',
        duration: '28 min',
        quartiere: 'Old town',
        startsAt: 'Strada Arco Basso',
        cover: '/images/covers/bari-tavola-cover.webp',
        objectPosition: 'top',
        alt: 'Fresh octopus served in Bari, a symbol of the city’s connection with the sea and the table',
        price: '€4.99',
      },
      {
        slug: 'porto-bari',
        title: 'Port of Bari — Where It All Happened',
        duration: '33 min',
        quartiere: 'Lungomare',
        startsAt: 'Molo San Nicola',
        cover: '/images/covers/porto-bari-card.jpg',
        alt: 'Historic port of Bari with sailing ships moored along the quay',
        price: '€4.99',
      },
      {
        slug: 'tre-teatri',
        title: 'The Three Theatres — Fire, Music, Bourgeoisie',
        duration: '28 min',
        quartiere: 'Murat',
        startsAt: 'Teatro Piccinni',
        cover: '/images/covers/tre-teatri-card.webp',
        alt: 'Teatro Petruzzelli, Teatro Piccinni and Teatro Margherita in Bari',
        price: '€4.99',
      },
      {
        slug: 'bari-sotterranea',
        title: 'Underground Bari — What Lies Beneath',
        duration: '26 min',
        quartiere: 'Old town',
        startsAt: 'Basilica di San Nicola',
        cover: '/images/covers/bari-sotterranea-card.jpg',
        alt: 'Underground entrance in the lanes of Old Bari with an illuminated stone stairway',
        price: '€4.99',
      },
    ];

const guidePathPrefix = lang === 'it' ? '/guide/' : lang === 'de' ? '/de/guide/' : '/en/guide/';
const startsLabel = lang === 'it' ? 'Parte da' : lang === 'de' ? 'Beginnt bei' : 'Starts at';
const subtitleBySlug: Record<string, Record<Lang, string>> = {
  'bari-vecchia': {
    it: 'Vicoli, corti e memoria: il borgo antico oltre la cartolina.',
    en: 'Lanes, courtyards and memory: the old town beyond the postcard.',
    de: 'Gassen, Hoefe und Erinnerung: die Altstadt jenseits der Postkarte.',
  },
  'san-nicola': {
    it: 'La basilica, la cripta e il santo che tiene insieme la citta.',
    en: 'The basilica, the crypt and the saint that holds the city together.',
    de: 'Die Basilika, die Krypta und der Heilige, der die Stadt verbindet.',
  },
  'bari-tavola': {
    it: 'Dal mare ai vicoli: il cibo come modo di stare insieme.',
    en: 'From the sea to the alleyways: food as a way of being together.',
    de: 'Vom Meer bis in die Gassen: Essen als Art des Zusammenlebens.',
  },
  'porto-bari': {
    it: 'Il mare, le partenze e gli arrivi che hanno costruito Bari.',
    en: 'The sea, departures and arrivals that shaped Bari.',
    de: 'Das Meer, die Aufbrueche und Ankuenfte, die Bari gepraegt haben.',
  },
  'tre-teatri': {
    it: 'Piccinni, Petruzzelli e Margherita: la citta vista dal palco.',
    en: 'Piccinni, Petruzzelli and Margherita: the city seen from the stage.',
    de: 'Piccinni, Petruzzelli und Margherita: die Stadt von der Buehne aus.',
  },
  'bari-sotterranea': {
    it: 'Sotto le strade: pietre, cripte e tracce della citta nascosta.',
    en: 'Beneath the streets: stones, crypts and traces of the hidden city.',
    de: 'Unter den Strassen: Steine, Krypten und Spuren der verborgenen Stadt.',
  },
};
const placeSubtitle = (slug: string) => subtitleBySlug[slug]?.[lang] ?? '';
const comingLabel = lang === 'it' ? 'In arrivo' : lang === 'de' ? 'Demnächst' : 'Coming';
---
<section id="guide" class="places-section bg-surface scroll-mt-lg">
  <div class="max-w-wrap mx-auto px-md sm:px-lg py-3xl lg:py-4xl">

    <!-- Section header -->
    <div class="places-header max-w-[60ch] mb-2xl lg:mb-3xl">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          {eyebrow}
        </span>
      </div>
      <h2 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(1.9rem,4.4vw,3rem)]">
        <span class="font-light">{heading1}</span>
        <span class="block font-body font-normal text-ink-muted mt-sm text-[clamp(1.15rem,2.4vw,1.55rem)] leading-relaxed tracking-normal">
          {heading2}
        </span>
      </h2>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
        {intro}
      </p>
    </div>

    <!-- Photo grid -->
    <ol class="places-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-lg gap-y-2xl list-none p-0 m-0">
      {places.map((p, i) => {
        const num = String(i + 1).padStart(2, '0');
        const isDraft = p.draft === true;
        const linkHref = isDraft ? '#guide' : `${guidePathPrefix}${p.slug}`;
        return (
          <li class="place-cell" style={`--idx:${i}`}>
            <a
              href={linkHref}
              class={`place-card ${isDraft ? 'is-draft' : ''}`}
              aria-label={isDraft ? `${comingLabel}: ${p.title}` : `${p.title} — ${startsLabel} ${p.startsAt}`}
            >
              <!-- Photo / placeholder -->
              <figure class="place-photo m-0">
                {!isDraft && p.cover ? (
                  <img
                    src={p.cover}
                    alt={p.alt}
                    class="place-img"
                    style={p.objectPosition ? `object-position: ${p.objectPosition}` : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="place-empty" aria-hidden="true">
                    <span class="place-empty-mark">06</span>
                    <span class="place-empty-label">{comingLabel}</span>
                  </div>
                )}
                <!-- Number stamp -->
                <span class="place-num" aria-hidden="true">{num}</span>
                <!-- Price chip top-right (only on live tiles) -->
                {!isDraft && p.price && (
                  <span class="place-price" aria-hidden="true">{p.price}</span>
                )}
                <!-- Bottom scrim with eyebrow -->
                {!isDraft && (
                  <span class="place-scrim" aria-hidden="true">
                    <span class="place-quartiere">{p.quartiere}</span>
                    <span class="place-duration">{p.duration}</span>
                  </span>
                )}
              </figure>

              <!-- Meta below photo -->
              <div class="place-meta">
                <h3 class="place-title font-display text-ink leading-[1.2] m-0">
                  <span class="font-light">{p.title}</span>
                </h3>
                <p class="place-sub font-body text-sm text-ink-muted m-0">{placeSubtitle(p.slug)}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .place-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: placeIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }

  .place-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--color-ink);
    padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .place-card.is-draft {
    border-top-style: dashed;
    border-top-color: var(--color-border);
  }

  .place-card:hover {
    transform: translateY(-2px);
  }

  /* Photo */
  .place-photo {
    position: relative;
    width: 100%;
    height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08),
                0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }

  .place-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.94) contrast(1.04);
  }

  /* Empty placeholder for the 6th tile */
  .place-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    background:
      radial-gradient(ellipse at 50% 40%, oklch(78% 0.012 75) 0%, oklch(78% 0.012 75) 28%, transparent 48%),
      var(--color-surface-elev);
  }
  .place-empty-mark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 6rem);
    line-height: 1;
    color: var(--color-accent);
    letter-spacing: -0.04em;
    user-select: none;
    opacity: 0.55;
  }
  .place-empty-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  /* Price chip top-right of photo — opposite the number stamp */
  .place-price {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    padding: 4px 10px 5px;
    line-height: 1.2;
    user-select: none;
    pointer-events: none;
    /* Sit above the photo but below scrim/labels if they overlap */
    z-index: 1;
    /* Subtle separation from busy photos */
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18);
  }

  /* Number stamp top-left of photo */
  .place-num {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.4rem, 4.4vw, 3.2rem);
    line-height: 0.85;
    color: var(--color-surface);
    letter-spacing: -0.04em;
    text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55);
    pointer-events: none;
    user-select: none;
  }
  .is-draft .place-num {
    display: none;
  }

  /* Bottom scrim with quartiere + duration */
  .place-scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-sm) var(--spacing-md);
    background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%);
    color: var(--color-surface);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .place-quartiere {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .place-duration {
    flex-shrink: 0;
    color: var(--color-accent-soft);
  }

  /* Meta */
  .place-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .place-title {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
  }
  .place-sub {
    line-height: 1.5;
  }

  /* Draft cell tones down meta */
  .is-draft .place-title {
    color: var(--color-ink-subtle);
  }

  .place-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @keyframes placeIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .place-cell,
    .place-card,
    .place-img {
      animation: none !important;
      transition: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
