---
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || 'localis.guide';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const isProd = import.meta.env.PROD;
---
{isProd && (
  <>
    {/* Plausible — privacy-friendly aggregate */}
    <script
      defer
      data-domain={domain}
      src="https://plausible.io/js/script.tagged-events.js"
    ></script>
    <script is:inline>
      window.plausible = window.plausible || function() {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
    </script>

    {ga4Id && (
      <>
        {/* Google Analytics 4 — referral-attributed events for QR-code partners */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());

          // Resolve partner_id BEFORE config so the first page_view is attributed.
          // Priority: ?p=<slug> in URL > lg_partner cookie > localStorage.
          let partnerId = null;
          try {
            const params = new URLSearchParams(window.location.search);
            const p = params.get('p');
            if (p && /^[a-z0-9][a-z0-9-]{2,40}$/i.test(p)) {
              partnerId = p;
            } else {
              const ck = document.cookie.split('; ').find((c) => c.startsWith('lg_partner='));
              if (ck) partnerId = decodeURIComponent(ck.split('=')[1] || '');
              else {
                const ls = localStorage.getItem('lg_partner');
                if (ls) partnerId = ls;
              }
            }
          } catch (e) {}

          gtag('config', ga4Id, {
            anonymize_ip: true,
            send_page_view: true,
          });

          // partner_id as user property (sticks across session) AND default event param
          if (partnerId) {
            gtag('set', 'user_properties', { partner_id: partnerId });
            gtag('set', { partner_id: partnerId });
          } else {
            gtag('set', 'user_properties', { partner_id: '(direct)' });
            gtag('set', { partner_id: '(direct)' });
          }

          // Unified tracker — fires GA4 + Plausible in one call.
          window.localisTrack = function (name, params) {
            params = params || {};
            if (!params.partner_id) params.partner_id = partnerId || '(direct)';
            try {
              if (typeof window.gtag === 'function') window.gtag('event', name, params);
            } catch (e) {}
            try {
              if (typeof window.plausible === 'function') window.plausible(name, { props: params });
            } catch (e) {}
          };
        </script>
      </>
    )}
  </>
)}
