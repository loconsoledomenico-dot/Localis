---
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || 'localis.guide';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const isProd = import.meta.env.PROD;
---
{isProd && (
  <>
    {/* Plausible — privacy-friendly aggregate */}
    <script
      defer
      data-domain={domain}
      src="https://plausible.io/js/script.tagged-events.js"
    ></script>
    <script is:inline>
      window.plausible = window.plausible || function() {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
    </script>

    {ga4Id && (
      <>
        {/* GA4 — deferred until cookie consent is given (GDPR Art. 6) */}
        <script define:vars={{ ga4Id }} is:inline>
          // Resolve partner_id from URL / cookie / localStorage (no network call yet).
          let _partnerId = null;
          try {
            const params = new URLSearchParams(window.location.search);
            const p = params.get('p');
            if (p && /^[a-z0-9][a-z0-9-]{2,40}$/i.test(p)) {
              _partnerId = p;
            } else {
              const ck = document.cookie.split('; ').find((c) => c.startsWith('lg_partner='));
              if (ck) _partnerId = decodeURIComponent(ck.split('=')[1] || '');
              else {
                const ls = localStorage.getItem('lg_partner');
                if (ls) _partnerId = ls;
              }
            }
          } catch (e) {}

          // Called by CookieBanner after consent, or on page load if consent already given.
          window.localisGA4Init = function () {
            if (window._ga4Loaded) return;
            window._ga4Loaded = true;

            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
            document.head.appendChild(s);

            window.dataLayer = window.dataLayer || [];
            function gtag(){ window.dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', ga4Id, { anonymize_ip: true, send_page_view: true });

            const pid = _partnerId || '(direct)';
            gtag('set', 'user_properties', { partner_id: pid });
            gtag('set', { partner_id: pid });

            window.localisTrack = function (name, params) {
              params = params || {};
              if (!params.partner_id) params.partner_id = pid;
              try { if (typeof window.gtag === 'function') window.gtag('event', name, params); } catch (e) {}
              try { if (typeof window.plausible === 'function') window.plausible(name, { props: params }); } catch (e) {}
            };
          };

          // Fallback localisTrack (Plausible only) before consent.
          window.localisTrack = window.localisTrack || function (name, params) {
            params = params || {};
            if (!params.partner_id) params.partner_id = _partnerId || '(direct)';
            try { if (typeof window.plausible === 'function') window.plausible(name, { props: params }); } catch (e) {}
          };
        </script>
      </>
    )}
  </>
)}
