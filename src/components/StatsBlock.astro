---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Tavola II — Il registro' : 'Plate II — The ledger';
const heading = lang === 'it'
  ? 'Una sola città. Storie che non si trovano in guida.'
  : 'One city. Stories you won\'t find in guidebooks.';

const stats = lang === 'it'
  ? [
      { value: '6', label: 'baresi che scrivono', tail: 'zero ghostwriter' },
      { value: '0', label: 'invenzioni', tail: 'ogni claim ha la sua fonte' },
      { value: '0', label: 'cookie banner', tail: 'zero account, zero password' },
      { value: '∞', label: 'riascolti', tail: 'link permanente, tua per sempre' },
    ]
  : [
      { value: '6', label: 'locals writing', tail: 'zero ghostwriters' },
      { value: '0', label: 'invented facts', tail: 'every claim has a source' },
      { value: '0', label: 'cookie banners', tail: 'zero accounts, zero passwords' },
      { value: '∞', label: 'replays', tail: 'permanent link, yours forever' },
    ];
---
<section class="stats bg-surface-elev border-y border-border">
  <div class="max-w-wrap mx-auto px-md sm:px-lg py-xl lg:py-2xl">

    <div class="flex items-center justify-center gap-sm mb-lg">
      <span class="block w-7 h-px bg-accent"></span>
      <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">
        {eyebrow}
      </span>
      <span class="block w-7 h-px bg-accent"></span>
    </div>

    <dl class="stats-grid grid grid-cols-2 lg:grid-cols-4 gap-md lg:gap-lg m-0 p-0">
      {stats.map((s, i) => (
        <div class="stat-cell text-center" style={`--idx:${i}`}>
          <dt class="sr-only">{s.label} — {s.tail}</dt>
          <dd class="m-0 p-0">
            <span
              class="stat-value block font-display font-light text-accent text-[clamp(2rem,4vw,3rem)] leading-none mb-2xs"
              style="font-variant-numeric: tabular-nums;"
            >{s.value}</span>
            <span class="block font-display text-ink text-[clamp(0.92rem,1.2vw,1.05rem)] leading-tight">
              {s.label}
            </span>
            <span class="block font-body italic text-ink-subtle text-[clamp(0.78rem,1vw,0.88rem)] leading-snug mt-2xs">
              {s.tail}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stat-cell {
    opacity: 0;
    transform: translateY(12px);
    animation: statIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 90ms + 120ms);
  }

  @keyframes statIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
