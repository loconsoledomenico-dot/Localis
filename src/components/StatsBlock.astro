---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Tavola IV — I numeri' : 'Plate IV — The numbers';
const heading = lang === 'it'
  ? 'Una sola città. Storie che non si trovano in guida.'
  : 'One city. Stories you won\'t find in guidebooks.';

const stats = lang === 'it'
  ? [
      { value: '6', label: 'baresi che scrivono', tail: 'zero ghostwriter' },
      { value: '0', label: 'invenzioni', tail: 'ogni claim ha la sua fonte' },
      { value: '0', label: 'cookie banner', tail: 'zero account, zero password' },
      { value: '∞', label: 'riascolti', tail: 'link permanente, tua per sempre' },
    ]
  : [
      { value: '6', label: 'locals writing', tail: 'zero ghostwriters' },
      { value: '0', label: 'invented facts', tail: 'every claim has a source' },
      { value: '0', label: 'cookie banners', tail: 'zero accounts, zero passwords' },
      { value: '∞', label: 'replays', tail: 'permanent link, yours forever' },
    ];
---
<section class="stats bg-surface-elev">
  <div class="max-w-wrap mx-auto px-md sm:px-lg py-3xl lg:py-4xl">

    <div class="flex items-center gap-sm mb-md">
      <span class="block w-7 h-px bg-accent"></span>
      <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
        {eyebrow}
      </span>
    </div>

    <h2 class="font-display text-ink text-[clamp(1.7rem,3.6vw,2.5rem)] leading-[1.15] tracking-[-0.012em] max-w-[28ch] mb-2xl">
      {heading}
    </h2>

    <dl class="stats-grid grid grid-cols-2 lg:grid-cols-4 gap-lg lg:gap-xl m-0 p-0">
      {stats.map((s, i) => (
        <div class="stat-cell" style={`--idx:${i}`}>
          <dt class="sr-only">{s.label} — {s.tail}</dt>
          <dd class="m-0 p-0">
            <span
              class="stat-value block font-display font-light text-accent text-[clamp(3rem,6vw,4.8rem)] leading-none mb-sm"
              style="font-variant-numeric: tabular-nums;"
            >{s.value}</span>
            <span aria-hidden="true" class="block w-8 h-px bg-border mb-sm"></span>
            <span class="block font-display text-ink text-[clamp(1.05rem,1.6vw,1.25rem)] leading-tight mb-2xs">
              {s.label}
            </span>
            <span class="block font-body italic text-ink-muted text-sm leading-snug max-w-[26ch]">
              {s.tail}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stat-cell {
    opacity: 0;
    transform: translateY(12px);
    animation: statIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 90ms + 120ms);
  }

  @keyframes statIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
