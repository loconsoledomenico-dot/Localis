---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Come funziona' : lang === 'de' ? 'So funktioniert es' : 'How it works';

const items = lang === 'it'
  ? [
      { value: '~30 min',   label: 'per guida',            tail: 'ascolto comodo, senza fretta' },
      { value: 'Senza app', label: 'niente da installare', tail: 'un link, premi play, ascolti' },
      { value: '€4,99',     label: 'una guida',            tail: 'o bundle da €11,99 / €19,99' },
    ]
  : lang === 'de'
  ? [
      { value: '~30 Min.',  label: 'pro Erzählung',          tail: 'in Ruhe hören, ohne Eile' },
      { value: 'Keine App', label: 'nichts zu installieren', tail: 'Link öffnen, Play drücken, zuhören' },
      { value: '4,99 €',    label: 'eine Erzählung',         tail: 'oder Bundle für 11,99 € / 19,99 €' },
    ]
  : [
      { value: '~30 min', label: 'per guide',           tail: 'comfortable listen, no rush' },
      { value: 'No app',  label: 'nothing to install',  tail: 'a link, press play, listen' },
      { value: '€4.99',   label: 'one guide',           tail: 'or bundle €11.99 / €19.99' },
    ];

const refundNote = lang === 'it'
  ? 'Rimborso semplice — scrivi a hello@localis.guide, soldi indietro senza domande.'
  : lang === 'de'
  ? 'Einfache Rückerstattung — schreib an hello@localis.guide, Geld zurück ohne Fragen.'
  : 'Simple refund — write to hello@localis.guide, money back, no questions.';
---
<section class="stats bg-surface-elev border-y border-border">
  <div class="max-w-wrap mx-auto px-md sm:px-lg pt-xl lg:pt-2xl pb-lg">

    <div class="flex items-center justify-center gap-sm mb-lg">
      <span class="block w-7 h-px bg-accent"></span>
      <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">
        {eyebrow}
      </span>
      <span class="block w-7 h-px bg-accent"></span>
    </div>

    <dl class="stats-grid grid grid-cols-3 gap-md lg:gap-lg m-0 p-0">
      {items.map((s, i) => (
        <div class="stat-cell text-center" style={`--idx:${i}`}>
          <dt class="sr-only">{s.label} — {s.tail}</dt>
          <dd class="m-0 p-0">
            <span
              class="stat-value block font-display font-light text-accent text-[clamp(1.5rem,3vw,2.25rem)] leading-none mb-2xs"
            >{s.value}</span>
            <span class="block font-display text-ink text-[clamp(0.92rem,1.2vw,1.05rem)] leading-tight">
              {s.label}
            </span>
            <span class="block font-body italic text-ink-subtle text-[clamp(0.78rem,1vw,0.88rem)] leading-snug mt-2xs">
              {s.tail}
            </span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="flex justify-center mt-lg">
      <p class="font-body text-[0.72rem] text-ink-subtle leading-relaxed text-center">
        {refundNote}
      </p>
    </div>
  </div>
</section>

<style>
  .stat-cell {
    opacity: 0;
    transform: translateY(12px);
    animation: statIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 90ms + 120ms);
  }

  @keyframes statIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
