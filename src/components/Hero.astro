---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const masthead_l = lang === 'it' ? 'Edizione 01 — Bari' : 'Edition 01 — Bari';
const masthead_r = lang === 'it' ? 'Sei guide live · edizione completa' : 'Six guides live · full edition';

const heading1a = lang === 'it' ? 'Audioguide raccontate' : 'Audio guides told';
const heading1b = lang === 'it' ? 'da chi ci è nato.' : 'by people born there.';

const lede1 = lang === 'it'
  ? 'I baresi ti raccontano la loro città.'
  : 'Locals telling their own city.';
const lede2 = lang === 'it'
  ? 'Quella vera, mica le brochure.'
  : 'The real one — not the brochure version.';

const ctaPrimary = lang === 'it' ? 'Ascolta un assaggio · 60 secondi gratis' : 'Listen a teaser · 60s free';
const ctaPrimaryHref = lang === 'it' ? '/guide/bari-vecchia' : '/en/guide/bari-vecchia';
const ctaSecondary = lang === 'it' ? 'Vedi le guide' : 'See the guides';

interface Pill {
  icon: string;
  label: string;
  tail: string;
}

const pills: Pill[] = lang === 'it'
  ? [
      { icon: 'headphones', label: 'Ascolta dove vuoi', tail: 'in strada, sul divano, in treno' },
      { icon: 'pin',        label: 'Storie vere',       tail: 'sui luoghi reali della città' },
      { icon: 'heart',      label: 'Da chi ci è nato',   tail: 'sei autori baresi firmati' },
    ]
  : [
      { icon: 'headphones', label: 'Listen anywhere',    tail: 'on the street, couch, train' },
      { icon: 'pin',        label: 'True stories',       tail: 'tied to real places' },
      { icon: 'heart',      label: 'Locals only',         tail: 'six signed Bari authors' },
    ];

const microline = lang === 'it'
  ? '~30 min per guida · senza app · rimborso 1-click · €4,99'
  : '~30 min per guide · no app · 1-click refund · €4.99';

const altText = lang === 'it'
  ? 'Una ragazza con cuffie sul lungomare di Bari al tramonto: cattedrale e palazzi storici a destra, sole che cala sul mare a sinistra'
  : 'A young woman with headphones on Bari\'s lungomare at sunset: cathedral and historic buildings to the right, sun setting over the sea to the left';
---
<section class="hero relative" aria-label="Localis — audioguide narrative di Bari">

  <!-- Full-bleed background image -->
  <img
    src="/images/hero/hero-bari-tramonto.jpg"
    alt={altText}
    class="hero-bg"
    width="1980"
    height="1056"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Gradient scrim for text legibility on the left half -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <!-- Masthead strip — sits over the photo at the top -->
  <div class="hero-masthead">
    <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle">
      {masthead_l}
    </span>
    <span class="hidden sm:inline text-[10px] font-semibold tracking-[0.28em] uppercase text-ink-subtle">
      {masthead_r}
    </span>
  </div>

  <!-- Content overlay — anchored left -->
  <div class="hero-content">
    <h1 class="hero-h1 font-display text-ink leading-[0.96] tracking-[-0.018em] m-0">
      <span class="hero-h1-a block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1a}</span>
      <span class="hero-h1-b block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1b}</span>
    </h1>

    <p class="hero-lede mt-md font-display italic text-ink text-[clamp(1.05rem,1.8vw,1.35rem)] leading-snug max-w-[42ch]">
      <span class="block">{lede1}</span>
      <span class="block">{lede2}</span>
    </p>

    <div class="hero-actions mt-lg flex flex-col sm:flex-row gap-sm">
      <a
        href={ctaPrimaryHref}
        class="inline-flex items-center justify-center gap-xs px-lg py-md rounded-md font-semibold text-sm bg-ink text-surface hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
        {ctaPrimary}
      </a>
      <a
        href="#guide"
        class="inline-flex items-center justify-center gap-xs px-lg py-md rounded-md font-semibold text-sm border border-ink text-ink hover:bg-ink hover:text-surface transition-colors duration-fast no-underline min-h-[48px]"
      >
        {ctaSecondary}
      </a>
    </div>

    <ul class="hero-pills">
      {pills.map((p) => (
        <li class="hero-pill">
          <span class="hero-pill-icon" aria-hidden="true">
            {p.icon === 'headphones' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            )}
            {p.icon === 'pin' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            )}
            {p.icon === 'heart' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            )}
          </span>
          <span class="hero-pill-text">
            <span class="hero-pill-label">{p.label}</span>
            <span class="hero-pill-tail">{p.tail}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Microline strip at very bottom of hero -->
  <div class="hero-microline">
    {microline}
  </div>

</section>

<style>
  .hero {
    --max-w: 1280px;
    --side-gutter: max(var(--spacing-lg), calc((100vw - var(--max-w)) / 2 + var(--spacing-lg)));

    position: relative;
    width: 100%;
    min-height: clamp(560px, 78vh, 820px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
    filter: saturate(0.96) contrast(1.02);
  }

  /* Scrim — fades cream surface from left to transparent at ~65% */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.72) 0%,
        oklch(from var(--color-surface) l c h / 0.55) 22%,
        oklch(from var(--color-surface) l c h / 0.28) 42%,
        oklch(from var(--color-surface) l c h / 0) 60%
      );
    pointer-events: none;
  }

  /* Vertical scrim on mobile so text reads over the photo */
  @media (max-width: 900px) {
    .hero-scrim {
      background:
        linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.94) 0%,
          oklch(from var(--color-surface) l c h / 0.78) 45%,
          oklch(from var(--color-surface) l c h / 0.55) 75%,
          oklch(from var(--color-surface) l c h / 0.4) 100%
        );
    }
    .hero-bg { object-position: 70% center; }
  }

  .hero-masthead {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-inline: var(--side-gutter);
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
  }
  .hero-masthead::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--side-gutter);
    right: var(--side-gutter);
    height: 1px;
    background: oklch(from var(--color-border) l c h / 0.6);
    transform: scaleX(0);
    transform-origin: left;
    animation: ruleDraw 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-inline-start: var(--side-gutter);
    padding-inline-end: var(--spacing-lg);
    padding-block: clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl));
    /* Total column width = left gutter + 620 content + small right breathing — content stays anchored left.
     * Caps at 100% on narrow viewports so it never overflows. */
    width: min(100%, calc(var(--side-gutter) + 620px + var(--spacing-lg)));
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 900px) {
    .hero-content {
      padding-inline-end: var(--side-gutter);
      width: 100%;
    }
  }

  /* Pills */
  .hero-pills {
    list-style: none;
    padding: 0;
    margin: clamp(2.25rem, 4vw, 3.25rem) 0 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    max-width: 560px;
  }
  @media (max-width: 600px) {
    .hero-pills {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }
  }

  .hero-pill {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    color: var(--color-ink);
  }
  .hero-pill-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .hero-pill-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .hero-pill-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-ink);
  }
  .hero-pill-tail {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-ink);
    margin-top: 1px;
  }

  /* Microline at bottom */
  .hero-microline {
    position: relative;
    z-index: 2;
    padding-inline: var(--side-gutter);
    padding-block: var(--spacing-md);
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }

  /* === Reveal animations === */
  .hero-masthead > span {
    opacity: 0;
    animation: heroFade 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
  }
  .hero-h1 > span {
    opacity: 0;
    transform: translateY(14px);
    animation: heroIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-h1-a { animation-delay: 0.35s; }
  .hero-h1-b { animation-delay: 0.55s; }
  .hero-lede,
  .hero-actions,
  .hero-pills,
  .hero-microline {
    opacity: 0;
    transform: translateY(10px);
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-lede     { animation-delay: 0.75s; }
  .hero-actions  { animation-delay: 0.9s; }
  .hero-pills    { animation-delay: 1.05s; }
  .hero-microline{ animation-delay: 1.2s; }

  @keyframes ruleDraw { to { transform: scaleX(1); } }
  @keyframes heroIn { to { opacity: 1; transform: translateY(0); } }
  @keyframes heroFade { to { opacity: 1; } }

  @media (max-width: 768px) {
    .hero-h1-a { animation-delay: 0.1s; animation-duration: 0.5s; }
    .hero-h1-b { animation-delay: 0.25s; animation-duration: 0.5s; }
    .hero-lede { animation-delay: 0.35s; animation-duration: 0.4s; }
    .hero-actions { animation-delay: 0.45s; animation-duration: 0.4s; }
    .hero-pills { animation-delay: 0.55s; animation-duration: 0.4s; }
    .hero-microline { animation-delay: 0.65s; animation-duration: 0.4s; }
    .hero-masthead > span { animation-delay: 0.3s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-masthead::before,
    .hero-masthead > span,
    .hero-h1 > span,
    .hero-lede,
    .hero-actions,
    .hero-pills,
    .hero-microline {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
