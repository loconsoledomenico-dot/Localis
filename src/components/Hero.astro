---
import { type Lang } from '../lib/i18n';
import LangPills from './LangPills.astro';
import HeroAudioSample from './HeroAudioSample.astro';

export interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;

const masthead_l = lang === 'de' ? 'Ausgabe 01 — Apulien' : lang === 'it' ? 'Edizione 01 — Puglia' : 'Edition 01 — Puglia';
const masthead_r = lang === 'de' ? 'Veröffentlichte Audioguides · Apulien' : lang === 'it' ? 'Guide pubblicate · Puglia' : 'Published guides · Puglia';

const heading1a = lang === 'de' ? 'Narrative Audioguides, um Apulien besser zu verstehen — auch schon vor der Reise.' : lang === 'it' ? 'Audioguide narrative per capire la Puglia, anche prima di partire.' : 'Self-guided audio tours of Puglia, right on your phone.';
const heading1b = '';

const lede1 = lang === 'de'
  ? 'Geschichten über Orte, Geschichte und lokale Erinnerung — mit überprüfbaren Quellen.'
  : lang === 'it'
  ? 'Bari, Valle d’Itria, Gargano: racconti dei luoghi, tra storia, memoria e fonti verificabili.'
  : 'Bari, Valle d’Itria and Gargano: routes, true stories and verifiable sources.';
const lede2 = lang === 'de'
  ? 'Keine App, kein Konto: Link öffnen, Play drücken, zuhören.'
  : lang === 'it'
  ? 'Niente app, niente account: compri, apri il link, premi play.'
  : 'No app, no account: buy, open the link, press play.';

const ctaPrimary = lang === 'de' ? 'Guide auswählen' : lang === 'it' ? 'Scegli la tua audioguida' : 'Choose your audio guide';
const ctaPrimaryHref = lang === 'de' ? '/de/guide' : lang === 'it' ? '/guide' : '/en/guide';

const quickPrice = lang === 'de' ? 'Ab 4,99 EUR' : lang === 'it' ? 'Da 4,99 EUR' : 'From EUR 4.99';
const quickBundle = lang === 'de' ? 'Pacchetti da 3, 6 o tutte le 18 guide' : lang === 'it' ? 'Pack da 3, 6 o tutte e 18 le guide' : 'Bundles of 3, 6, or all 18 guides';
const quickAccess = lang === 'de' ? 'Link sofort. Streaming oder offline speichern nach dem Kauf.' : lang === 'it' ? 'Link immediato. Ascolta in streaming o salva offline dopo l\'acquisto.' : 'Instant link. Stream now or save offline after purchase.';
const quickPricingLabel = lang === 'de' ? 'Preise ansehen' : lang === 'it' ? 'Vedi prezzi' : 'See pricing';
const quickHowLabel = lang === 'de' ? 'Come funziona' : lang === 'it' ? 'Come funziona' : 'How it works';

const altText = lang === 'de'
  ? 'Eine junge Frau mit Kopfhörern auf Baris Lungomare bei Sonnenuntergang'
  : lang === 'it'
  ? 'Una ragazza con cuffie sul lungomare di Bari al tramonto: cattedrale e palazzi storici a destra, sole che cala sul mare a sinistra'
  : 'A young woman with headphones on Bari\'s lungomare at sunset: cathedral and historic buildings to the right, sun setting over the sea to the left';
---
<section class="hero relative" aria-label="Localis — audioguide narrative della Puglia">

  <!-- Full-bleed background image -->
  <img
    src="/images/hero/landing-puglia.jpg"
    alt={altText}
    class="hero-bg"
    width="1980"
    height="1056"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Gradient scrim for text legibility on the left half -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <!-- Masthead strip — sits over the photo at the top -->
  <div class="hero-masthead">
    <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-ink-subtle">
      {masthead_l}
    </span>
    <span class="hidden sm:inline text-[10px] font-semibold tracking-[0.28em] uppercase text-ink-subtle">
      {masthead_r}
    </span>
  </div>

  <!-- Content overlay — anchored left -->
  <div class="hero-content">
    <LangPills lang={lang} currentPath={currentPath} />
    <h1 class="hero-h1 font-display text-ink leading-[0.96] tracking-[-0.018em] m-0">
      <span class="hero-h1-a block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1a}</span>
      {heading1b && <span class="hero-h1-b block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1b}</span>}
    </h1>

    <p class="hero-lede mt-md font-display italic text-ink text-[clamp(1.05rem,1.8vw,1.35rem)] leading-snug max-w-[42ch]">
      <span class="block">{lede1}</span>
      <span class="block">{lede2}</span>
    </p>

    <HeroAudioSample lang={lang} src={lang === 'en' ? '/audio/trailers/hero-sample-en.mp3' : '/audio/trailers/hero-sample.mp3'} />

    <div class="hero-actions mt-lg flex flex-col sm:flex-row gap-sm flex-wrap">
      <a
        href={ctaPrimaryHref}
        class="inline-flex items-center justify-center gap-xs px-lg py-md rounded-md font-semibold text-sm bg-ink text-surface hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
        {ctaPrimary}
      </a>
      {lang === 'it' && (
        <a
          href="/crocieristi"
          class="inline-flex items-center justify-center gap-xs px-md py-sm rounded-full font-semibold text-xs border border-ink/30 text-ink bg-surface/80 hover:bg-surface transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[40px] backdrop-blur-sm"
        >
          ⚓ Sei in crociera? Pacchetto dedicato
        </a>
      )}
      {lang === 'en' && (
        <a
          href="/en/cruise"
          class="inline-flex items-center justify-center gap-xs px-md py-sm rounded-full font-semibold text-xs border border-ink/30 text-ink bg-surface/80 hover:bg-surface transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[40px] backdrop-blur-sm"
        >
          ⚓ On a cruise? Dedicated package
        </a>
      )}
      {lang === 'de' && (
        <a
          href="/de/kreuzfahrt"
          class="inline-flex items-center justify-center gap-xs px-md py-sm rounded-full font-semibold text-xs border border-ink/30 text-ink bg-surface/80 hover:bg-surface transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[40px] backdrop-blur-sm"
        >
          ⚓ Auf Kreuzfahrt? Spezielles Paket
        </a>
      )}
    </div>
    {lang === 'it' && (
      <p class="hero-cruise-note mt-sm text-xs text-ink-muted max-w-[36ch] m-0">
        Per chi ha solo 4 o 5 ore a terra: 2 audioguide brevi, a piedi dal Terminal Crociere.
      </p>
    )}
    {lang === 'en' && (
      <p class="hero-cruise-note mt-sm text-xs text-ink-muted max-w-[36ch] m-0">
        Built for travellers with only 4 to 5 hours ashore: 2 short audio guides, on foot from the cruise terminal.
      </p>
    )}
    {lang === 'de' && (
      <p class="hero-cruise-note mt-sm text-xs text-ink-muted max-w-[36ch] m-0">
        Fuer Reisende mit nur 4 bis 5 Stunden an Land: 2 kurze Audioguides, zu Fuss ab dem Kreuzfahrtterminal.
      </p>
    )}

    <div class="hero-offer mt-lg" aria-label={lang === 'de' ? 'Schnellueberblick zum Angebot' : lang === 'it' ? 'Panoramica rapida dell offerta' : 'Quick offer summary'}>
      <div class="hero-offer-grid">
        <p class="hero-offer-item">
          <span class="hero-offer-kicker">{lang === 'de' ? 'Catalogo' : lang === 'it' ? 'Catalogo' : 'Catalog'}</span>
          <span class="hero-offer-value">18 guide</span>
        </p>
        <p class="hero-offer-item">
          <span class="hero-offer-kicker">{lang === 'de' ? 'Prezzo' : lang === 'it' ? 'Prezzo' : 'Pricing'}</span>
          <span class="hero-offer-value">{quickPrice}</span>
        </p>
        <p class="hero-offer-item">
          <span class="hero-offer-kicker">{lang === 'de' ? 'Accesso' : lang === 'it' ? 'Accesso' : 'Access'}</span>
          <span class="hero-offer-value">{quickAccess}</span>
        </p>
      </div>
      <p class="hero-offer-summary">{quickBundle}</p>
      <div class="hero-offer-links">
        <a href="#prezzi" class="hero-offer-link">{quickPricingLabel}</a>
        <a href="#come-funziona" class="hero-offer-link">{quickHowLabel}</a>
      </div>
    </div>

  </div>


</section>

<style>
  .hero {
    --max-w: 1280px;
    --side-gutter: max(var(--spacing-lg), calc((100vw - var(--max-w)) / 2 + var(--spacing-lg)));

    position: relative;
    width: 100%;
    min-height: clamp(560px, 78vh, 820px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
    filter: saturate(0.96) contrast(1.02);
  }

  /* Scrim — fades cream surface from left to transparent at ~65% */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.88) 28%,
        oklch(from var(--color-surface) l c h / 0.55) 52%,
        oklch(from var(--color-surface) l c h / 0) 72%
      );
    pointer-events: none;
  }

  /* Vertical scrim on mobile so text reads over the photo */
  @media (max-width: 900px) {
    .hero-scrim {
      background:
        linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.94) 0%,
          oklch(from var(--color-surface) l c h / 0.78) 45%,
          oklch(from var(--color-surface) l c h / 0.55) 75%,
          oklch(from var(--color-surface) l c h / 0.4) 100%
        );
    }
    .hero-bg { object-position: 70% center; }
  }

  .hero-masthead {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-inline: var(--side-gutter);
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
  }
  .hero-masthead::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--side-gutter);
    right: var(--side-gutter);
    height: 1px;
    background: oklch(from var(--color-border) l c h / 0.6);
    transform: scaleX(0);
    transform-origin: left;
    animation: ruleDraw 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-inline-start: var(--side-gutter);
    padding-inline-end: var(--spacing-lg);
    padding-block: clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl));
    /* Total column width = left gutter + 620 content + small right breathing — content stays anchored left.
     * Caps at 100% on narrow viewports so it never overflows. */
    width: min(100%, calc(var(--side-gutter) + 620px + var(--spacing-lg)));
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 900px) {
    .hero-content {
      padding-inline-end: var(--side-gutter);
      width: 100%;
    }
  }

  /* === Reveal animations === */
  .hero-masthead > span {
    opacity: 0;
    animation: heroFade 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
  }
  .hero-h1 > span {
    opacity: 0;
    transform: translateY(14px);
    animation: heroIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-h1-a { animation-delay: 0.35s; }
  .hero-h1-b { animation-delay: 0.55s; }
  .hero-lede,
  :global(.hero-sample),
  .hero-actions {
    opacity: 0;
    transform: translateY(10px);
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-lede     { animation-delay: 0.75s; }
  :global(.hero-sample) { animation-delay: 0.9s; }
  .hero-actions  { animation-delay: 1.05s; }
  .hero-offer {
    opacity: 0;
    transform: translateY(10px);
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.15s forwards;
    background: oklch(from var(--color-surface) l c h / 0.72);
    border: 1px solid oklch(from var(--color-border) l c h / 0.82);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    max-width: 42rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 36px -26px oklch(20% 0.025 240 / 0.35);
  }
  .hero-offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }
  .hero-offer-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }
  .hero-offer-kicker {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
  .hero-offer-value {
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .hero-offer-summary {
    margin-top: var(--spacing-sm);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .hero-offer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }
  .hero-offer-link {
    color: var(--color-ink);
    font-size: 0.83rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid oklch(from var(--color-ink) l c h / 0.28);
    padding-bottom: 2px;
  }
  .hero-offer-link:hover {
    color: var(--color-link-pressed);
    border-bottom-color: oklch(from var(--color-link-pressed) l c h / 0.4);
  }

  @keyframes ruleDraw { to { transform: scaleX(1); } }
  @keyframes heroIn { to { opacity: 1; transform: translateY(0); } }
  @keyframes heroFade { to { opacity: 1; } }

  @media (max-width: 768px) {
    /* animations */
    .hero-h1-a { animation-delay: 0.1s; animation-duration: 0.5s; }
    .hero-h1-b { animation-delay: 0.25s; animation-duration: 0.5s; }
    .hero-lede { animation-delay: 0.35s; animation-duration: 0.4s; }
    :global(.hero-sample) { animation-delay: 0.45s; animation-duration: 0.4s; }
    .hero-actions { animation-delay: 0.55s; animation-duration: 0.4s; }
    .hero-masthead > span { animation-delay: 0.3s; }

    /* legibility */
    .hero-lede {
      font-size: 1.2rem;
      line-height: 1.5;
      margin-top: var(--spacing-lg);
    }
    :global(.hero-sample),
    .hero-actions {
      margin-top: var(--spacing-xl);
      gap: var(--spacing-md);
    }
    .hero-offer {
      margin-top: var(--spacing-xl);
      animation-delay: 0.65s;
    }
    .hero-offer-grid {
      grid-template-columns: 1fr;
    }
    .hero-offer-links {
      gap: var(--spacing-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-masthead::before,
    .hero-masthead > span,
    .hero-h1 > span,
    .hero-lede,
    :global(.hero-sample),
    .hero-actions,
    .hero-offer {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
