---
import '../styles/global.css';
import SkipLink from './SkipLink.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyPlayer from './StickyPlayer.astro';
import StructuredData from './StructuredData.astro';
import Analytics from './Analytics.astro';
import CookieBanner from './CookieBanner.astro';
import { type Lang, allLangUrls } from '../lib/i18n';
import { organizationLD } from '../lib/seo';

export interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
}

const { title, description = '', lang = 'it', ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const langUrls = allLangUrls(currentPath);
const itUrl = langUrls.it;
const enUrl = langUrls.en;
const deUrl = langUrls.de;
const SITE = 'https://localis.guide';
const canonical = `${SITE}${currentPath}`;
const ogLocale = lang === 'en' ? 'en_US' : lang === 'de' ? 'de_DE' : 'it_IT';
const alternateOgLocales = ['it_IT', 'en_US', 'de_DE'].filter((locale) => locale !== ogLocale);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FAF7F2" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="it" href={`${SITE}${itUrl}`} />
  <link rel="alternate" hreflang="en" href={`${SITE}${enUrl}`} />
  <link rel="alternate" hreflang="de" href={`${SITE}${deUrl}`} />
  <link rel="alternate" hreflang="x-default" href={`${SITE}${itUrl}`} />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  {alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
  <meta property="og:site_name" content="Localis" />
  <meta property="og:image" content={ogImage ? `${SITE}${ogImage}` : `${SITE}/og-default.jpg`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage ? `${SITE}${ogImage}` : `${SITE}/og-default.jpg`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.bunny.net" />
  <link
    href="https://fonts.bunny.net/css?family=spectral:300,300i,400,400i,500,500i,600,600i|schibsted-grotesk:400,500,600,700&display=swap"
    rel="stylesheet"
  />
  <Analytics />
  <StructuredData data={organizationLD()} />
</head>
<body class="bg-surface text-ink font-body antialiased min-h-screen flex flex-col">
  <SkipLink lang={lang} />
  <Header lang={lang} currentPath={currentPath} />

  <main id="main" class="flex-1">
    <slot />
  </main>

  <Footer lang={lang} />

  <StickyPlayer lang={lang} />
  <CookieBanner lang={lang} />

  <script is:inline define:vars={{ currentPath, lang }}>
    (function() {
      try {
        const params = new URLSearchParams(window.location.search);
        const p = params.get('p');
        if (p && /^[a-z0-9][a-z0-9-]{2,40}$/i.test(p)) {
          const cookieVal = document.cookie.split('; ').find(c => c.startsWith('lg_partner='));
          if (!cookieVal) {
            document.cookie = `lg_partner=${p}; path=/; max-age=${30*24*60*60}; SameSite=Lax`;
          }
          localStorage.setItem('lg_partner', p);
          localStorage.setItem('lg_partner_ts', String(Date.now()));

          const trackKey = `qr_landing_viewed:${p}:${currentPath}:${lang}`;
          if (!sessionStorage.getItem(trackKey) && typeof window.localisTrack === 'function') {
            sessionStorage.setItem(trackKey, '1');
            window.localisTrack('qr_landing_viewed', {
              partner_id: p,
              path: currentPath,
              lang,
              source: 'partner_qr',
            });
          }
        }

        const ls = localStorage.getItem('lg_partner');
        const lsTs = parseInt(localStorage.getItem('lg_partner_ts') || '0', 10);
        const expired = Date.now() - lsTs > 30*24*60*60*1000;
        if (ls && !expired) {
          const cookieExists = document.cookie.split('; ').some(c => c.startsWith('lg_partner='));
          if (!cookieExists) {
            document.cookie = `lg_partner=${ls}; path=/; max-age=${30*24*60*60}; SameSite=Lax`;
          }
        }
      } catch (e) {}
    })();
  </script>
</body>
</html>
