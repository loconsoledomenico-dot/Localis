---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';
import { formatDuration } from '../lib/format';
import { guideDurationSeconds } from '../lib/guide-localization';

export interface Props {
  guide: CollectionEntry<'guides'>['data'];
  lang: Lang;
}

const { guide, lang } = Astro.props;
const durationLabel = formatDuration(guideDurationSeconds(guide, lang));
const chapterCount = guide.chapters.length;

const defaultIntro = lang === 'it'
  ? 'Ascoltala con calma — in camera prima di uscire, oppure sul posto mentre cammini. Localis non è una navigazione turn-by-turn: ti dà contesto, storia e lo sguardo di chi ci vive, per capire dove sei.'
  : lang === 'de'
    ? 'Hör sie in Ruhe — im Zimmer, bevor du losgehst, oder vor Ort beim Gehen. Localis ist keine Turn-by-Turn-Navigation: Es gibt dir Kontext, Geschichte und den Blick von jemandem, der hier lebt, damit du verstehst, wo du bist.'
    : "Listen at your own pace — in your room before heading out, or on location as you walk. Localis is not turn-by-turn navigation: it gives you context, history, and the perspective of someone who lives here, so you understand where you are.";

const introOverride = lang === 'it'
  ? guide.use_case_intro_it
  : lang === 'de'
    ? (guide.use_case_intro_de ?? guide.use_case_intro_en)
    : guide.use_case_intro_en;

const copy = lang === 'it'
  ? {
      heading: 'Come ascoltarla',
      intro: introOverride ?? defaultIntro,
      items: [
        { label: 'Durata', value: `${durationLabel} · ${chapterCount} capitoli audio` },
        { label: 'Accesso', value: 'Dopo l\'acquisto ricevi subito il link. Ascolta in streaming oppure salva offline prima di iniziare.' },
        { label: 'Lingue', value: 'Indicate in ogni racconto' },
      ],
    }
  : lang === 'de'
    ? {
        heading: 'So hoerst du die Erzaehlung',
        intro: introOverride ?? defaultIntro,
        items: [
          { label: 'Dauer', value: `${durationLabel}, ${chapterCount} Kapitel` },
          { label: 'Zugang', value: 'Nach dem Kauf erhaeltst du sofort den Link. Du kannst sie streamen oder fuer das Offline-Hoeren speichern.' },
          { label: 'Sprachen', value: 'Bei jeder Erzaehlung angegeben' },
        ],
      }
    : {
        heading: 'How to listen',
        intro: introOverride ?? defaultIntro,
        items: [
          { label: 'Runtime', value: `${durationLabel}, ${chapterCount} chapters` },
          { label: 'Access', value: 'After purchase, you receive an immediate link. Stream it or save it for offline listening before you begin.' },
          { label: 'Languages', value: 'Shown for each story' },
        ],
      };
---
<section class="border border-border bg-surface-elev rounded-lg p-lg">
  <h2 class="font-display text-2xl text-ink mb-sm">{copy.heading}</h2>
  <p class="text-base text-ink-muted leading-relaxed mb-md">{copy.intro}</p>
  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-md">
    {copy.items.map((item) => (
      <div>
        <dt class="text-xs font-semibold tracking-[0.18em] uppercase text-accent mb-2xs">{item.label}</dt>
        <dd class="text-sm text-ink leading-relaxed m-0">{item.value}</dd>
      </div>
    ))}
  </dl>
</section>