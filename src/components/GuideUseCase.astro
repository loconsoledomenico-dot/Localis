---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';
import { formatDuration } from '../lib/format';
import { guideDurationSeconds } from '../lib/guide-localization';

export interface Props {
  guide: CollectionEntry<'guides'>['data'];
  lang: Lang;
}

const { guide, lang } = Astro.props;
const durationLabel = formatDuration(guideDurationSeconds(guide, lang));
const chapterCount = guide.chapters.length;

const copy = lang === 'it'
  ? {
      heading: 'Come ascoltarla',
      intro: 'Puoi ascoltare questo racconto liberamente oppure, se indicato, partire dal punto consigliato e attraversare il luogo mentre la storia procede. Localis non è una navigazione turn-by-turn: per orientarti usa la mappa del telefono.',
      items: [
        { label: 'Durata', value: `${durationLabel}, ${chapterCount} capitoli` },
        { label: 'Accesso', value: 'Dopo l\'acquisto ricevi subito il link. Ascolta in streaming oppure salva offline durante la visita.' },
        { label: 'Lingue', value: 'Indicate in ogni racconto' },
      ],
    }
  : lang === 'de'
    ? {
        heading: 'So hoerst du die Erzaehlung',
        intro: 'Du kannst sie frei anhoeren oder, falls angegeben, am empfohlenen Startpunkt beginnen und den Ort durchqueren, waehrend sich die Geschichte entfaltet. Localis ist keine Turn-by-Turn-Navigation: Nutze die Karte deines Telefons zur Orientierung.',
        items: [
          { label: 'Dauer', value: `${durationLabel}, ${chapterCount} Kapitel` },
          { label: 'Zugang', value: 'Nach dem Kauf erhaeltst du sofort den Link. Du kannst sie streamen oder fuer das Offline-Hoeren speichern.' },
          { label: 'Sprachen', value: 'Bei jeder Erzaehlung angegeben' },
        ],
      }
    : {
        heading: 'How to listen',
        intro: "You can listen freely, or, where indicated, begin from the suggested starting point and walk through the place as the story unfolds. Localis is not turn-by-turn navigation: use your phone map to find your way.",
        items: [
          { label: 'Runtime', value: `${durationLabel}, ${chapterCount} chapters` },
          { label: 'Access', value: 'After purchase, you receive an immediate link. Stream it or save it for offline listening during your visit.' },
          { label: 'Languages', value: 'Shown for each story' },
        ],
      };
---
<section class="border border-border bg-surface-elev rounded-lg p-lg">
  <h2 class="font-display text-2xl text-ink mb-sm">{copy.heading}</h2>
  <p class="text-base text-ink-muted leading-relaxed mb-md">{copy.intro}</p>
  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-md">
    {copy.items.map((item) => (
      <div>
        <dt class="text-xs font-semibold tracking-[0.18em] uppercase text-accent mb-2xs">{item.label}</dt>
        <dd class="text-sm text-ink leading-relaxed m-0">{item.value}</dd>
      </div>
    ))}
  </dl>
</section>